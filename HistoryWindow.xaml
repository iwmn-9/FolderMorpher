<Window x:Class="AstraSize.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AstraSize.Models"
        Title="容量推移グラフ &amp; スキャン履歴"
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBackground}"
        FontFamily="{StaticResource MainFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Info -->
            <RowDefinition Height="180"/>  <!-- Trend Visual Chart -->
            <RowDefinition Height="*"/>    <!-- History Table List -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📈 " FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="容量推移グラフ &amp; スキャン履歴" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TargetPathText" Text="対象パス: -" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Visual Trend Chart (Vector Area/Line Chart) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="📊 容量変化タイムライン (推移グラフ)" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock x:Name="ChartStatsTextBlock" Text="--" FontSize="11" Foreground="#0284C7" HorizontalAlignment="Right"/>
                </Grid>
                <Canvas x:Name="TrendCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="TrendCanvas_SizeChanged" Background="#F8FAFC"/>
                <TextBlock x:Name="NoChartDataText" Grid.Row="1" Text="グラフを描画するには2回以上のスキャン履歴が必要です"
                           FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- History Items Table -->
        <Border Grid.Row="2" Style="{StaticResource FluentCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Table Header -->
                <Border Grid.Row="0" Background="#F1F5F9" Padding="16,8" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="スキャン日時" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                        <TextBlock Grid.Column="1" Text="総容量" FontWeight="SemiBold" FontSize="11" Foreground="#475569" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="項目数" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="30,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="前回との増減" FontWeight="SemiBold" FontSize="11" Foreground="#475569" TextAlignment="Right"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoryItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ScanSnapshot}">
                                <Border Padding="16,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Date -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#0284C7" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding FormattedDate}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        </StackPanel>

                                        <!-- Size -->
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="13" FontWeight="Bold"
                                                   FontFamily="{StaticResource MonoFont}" Foreground="#0F172A" VerticalAlignment="Center" TextAlignment="Right"/>

                                        <!-- Files -->
                                        <TextBlock Grid.Column="2" Text="{Binding TotalFiles, StringFormat={}{0:N0} 項目}"
                                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="30,0,0,0"/>

                                        <!-- Diff / Status -->
                                        <TextBlock Grid.Column="3" Text="履歴記録済" FontSize="11" Foreground="#059669"
                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Empty text -->
        <TextBlock x:Name="EmptyHistoryText" Grid.Row="2" Text="このパスに関する過去のスキャン履歴はありません。"
                   FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button Content="閉じる" HorizontalAlignment="Right" Style="{StaticResource FluentButtonPrimary}" Width="100" Height="32" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
