<Window x:Class="AstraSize.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AstraSize.Models"
        Title="容量の推移・スキャン履歴"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBackground}"
        FontFamily="{StaticResource MainFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Info -->
            <RowDefinition Height="*"/>    <!-- History List -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📈 " FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="容量の推移・スキャン履歴" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TargetPathText" Text="対象パス: -" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- History Items -->
        <Border Grid.Row="1" Style="{StaticResource FluentCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ScanSnapshot}">
                            <Border Padding="16,12" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Dot / Line -->
                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="#0284C7" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedDate}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding TotalFiles, StringFormat={}{0:N0} 項目}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="14" FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFont}" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Empty text -->
        <TextBlock x:Name="EmptyHistoryText" Grid.Row="1" Text="このパスに関する過去のスキャン履歴はありません。"
                   FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button Content="閉じる" HorizontalAlignment="Right" Style="{StaticResource FluentButtonPrimary}" Width="90" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
