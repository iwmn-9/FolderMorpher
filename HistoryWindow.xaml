<Window x:Class="AstraSize.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AstraSize.Models"
        Title="容量推移グラフ &amp; 数理予測"
        Height="720" Width="920"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBackground}"
        FontFamily="{StaticResource MainFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Threshold Controls -->
            <RowDefinition Height="230"/>  <!-- Trend Visual Chart & Forecasting -->
            <RowDefinition Height="*"/>    <!-- History Table & Contributor Breakdown -->
            <RowDefinition Height="Auto"/> <!-- Actions / Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📈 " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HistoryWindowTitleText" Text="容量推移グラフ &amp; 数理予測" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TargetPathText" Text="対象パス: -" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Target Threshold Input & Status -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TargetThresholdLabel" Text="目標上限閾値:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="ThresholdInputTextBox" Width="100" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                             FontSize="12" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="#0F172A"
                             Margin="0,0,6,0" KeyDown="ThresholdInputTextBox_KeyDown" LostFocus="ThresholdInputTextBox_LostFocus"/>
                    <Button x:Name="ApplyThresholdButton" Content="再計算" Style="{StaticResource FluentButtonSecondary}" Height="28" Padding="8,0"
                            Click="ApplyThresholdButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Visual Trend Chart (Vector Area/Line Chart + Forecasts) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Chart Top Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ChartTitleTextBlock" Text="📊 容量変化タイムライン ＆ 一次線形・Holtトレンド予測" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                    </StackPanel>
                    <TextBlock x:Name="ChartStatsTextBlock" Text="--" FontSize="11" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Canvas for Chart -->
                <Canvas x:Name="TrendCanvas" Grid.Row="1" ClipToBounds="True" SizeChanged="TrendCanvas_SizeChanged" Background="#F8FAFC"/>

                <TextBlock x:Name="NoChartDataText" Grid.Row="1" Text="グラフを描画するには2回以上のスキャン履歴が必要です"
                           FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Chart Legend -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Rectangle Width="12" Height="3" Fill="#0284C7" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="LegendMeasuredText" Text="実測容量" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Rectangle Width="12" Height="2" Fill="#8B5CF6" StrokeDashArray="3,2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="LegendRegressionText" Text="一次線形回帰" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Rectangle Width="12" Height="2" Fill="#EF4444" StrokeDashArray="2,2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="LegendTargetText" Text="目標上限" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="LegendAnomalyText" Text="⚠️ 異常急増 (MAD)" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area: History List & Contributor Inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ContributorCol" Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- History Items Table -->
            <Border Grid.Column="0" Style="{StaticResource FluentCard}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#F1F5F9" Padding="14,8" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ColHeaderDate" Grid.Column="0" Text="スキャン日時" FontWeight="SemiBold" FontSize="11" Foreground="#475569"/>
                            <TextBlock x:Name="ColHeaderSize" Grid.Column="1" Text="総容量" FontWeight="SemiBold" FontSize="11" Foreground="#475569" TextAlignment="Right"/>
                            <TextBlock x:Name="ColHeaderItems" Grid.Column="2" Text="項目数" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="14,0,0,0"/>
                            <TextBlock x:Name="ColHeaderGrowth" Grid.Column="3" Text="前回との増減" FontWeight="SemiBold" FontSize="11" Foreground="#475569" TextAlignment="Right"/>
                            <TextBlock x:Name="ColHeaderAnomaly" Grid.Column="4" Text="異常判定 / 状態" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="HistoryItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,9" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Background="Transparent"
                                            MouseLeftButtonUp="HistoryRow_MouseLeftButtonUp" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Date -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusDotBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding FormattedDate}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            </StackPanel>

                                            <!-- Size -->
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="12.5" FontWeight="Bold"
                                                       FontFamily="{StaticResource MonoFont}" Foreground="#0F172A" VerticalAlignment="Center" TextAlignment="Right"/>

                                            <!-- Files -->
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedFiles}"
                                                       FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0"/>

                                            <!-- Diff -->
                                            <TextBlock Grid.Column="3" Text="{Binding FormattedDiff}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding DiffBrush}" VerticalAlignment="Center" TextAlignment="Right"/>

                                            <!-- Anomaly Status Badge -->
                                            <Border Grid.Column="4" Background="{Binding BadgeBackgroundBrush}" CornerRadius="4" Padding="6,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                                                    Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding BadgeForegroundBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Contributor Breakdown Inspector (Right Pane) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock x:Name="InspectorTitleText" Text="💡 急増主因 内訳 (Top 5)" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="InspectorDateText" Text="スキャン行をクリックして選択" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="NoContributorsText" Grid.Row="1" Text="急増なし、または比較データがありません"
                               FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0" Visibility="Collapsed"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl x:Name="ContributorsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6"
                                            MouseLeftButtonDown="ContributorItem_MouseLeftButtonDown" Cursor="Hand" ToolTip="{Binding DoubleClickToolTip}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Folder Name -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- Ratio Badge -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="#FEF3C7" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="{Binding ContributionPercent, StringFormat={}{0}%}" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                            </Border>

                                            <!-- Sub details -->
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding GrowthPrefixText}" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding FormattedDelta}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E11D48" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding CurrentPrefixText}" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding FormattedCurrentSize}" FontSize="10.5" Foreground="#334155"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Empty text -->
            <TextBlock x:Name="EmptyHistoryText" Grid.Column="0" Text="このパスに関する過去のスキャン履歴はありません。"
                       FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="ForecastSummaryFooterText" Text="--" FontSize="11.5" Foreground="#475569" VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Content="閉じる" HorizontalAlignment="Right" Style="{StaticResource FluentButtonPrimary}" Width="100" Height="32" Click="CloseButton_Click"/>
        </DockPanel>
    </Grid>
</Window>

