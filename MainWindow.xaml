                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="プリンシパル (対象アカウント):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBox x:Name="SecPrincipalInput" Height="28" FontSize="11" FontWeight="Bold" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="種類:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="SecAccessTypeCombo" Height="28" SelectedIndex="0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="許可"/>
                                        <ComboBoxItem Content="拒否"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="適用先:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox x:Name="SecAppliesToCombo" Height="28" SelectedIndex="0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="このフォルダー、サブフォルダーおよびファイル"/>
                                    <ComboBoxItem Content="このフォルダーのみ"/>
                                    <ComboBoxItem Content="このフォルダーおよびサブフォルダー"/>
                                    <ComboBoxItem Content="このフォルダーおよびファイル"/>
                                    <ComboBoxItem Content="サブフォルダーおよびファイルのみ"/>
                                    <ComboBoxItem Content="サブフォルダーのみ"/>
                                    <ComboBoxItem Content="ファイルのみ"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Basic Permissions -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="基本アクセス許可:" FontWeight="Bold" FontSize="12.5" Foreground="#334155"/>
                                        <TextBlock Text="※高度な権限と完全リアルタイム連動" FontSize="11.5" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="SecChkFullControl" Content="フル コントロール" Margin="0,3" FontWeight="Bold" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkModify" Content="変更 (Modify)" Margin="0,3" FontWeight="Bold" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkReadExecute" Content="読み取りと実行" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkList" Content="フォルダーの内容の一覧表示" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkRead" Content="読み取り" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkWrite" Content="書き込み" Margin="0,3" Click="SecBasicPerm_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Permissions (14 items) -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="⚙️ 高度なアクセス許可 (Windows ACL 14項目完全網羅):" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                        <TextBlock Text="Windows セキュリティ詳細設定準拠" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="SecAdvTraverse" Content="フォルダーのスキャン / ファイルの実行" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvList" Content="フォルダーの一覧 / データの読み取り" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadAttr" Content="属性の読み取り" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadExtAttr" Content="拡張属性の読み取り" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvCreateFile" Content="ファイルの作成 / データの書き込み" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvCreateFolder" Content="フォルダーの作成 / データの追加" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvWriteAttr" Content="属性の書き込み" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvWriteExtAttr" Content="拡張属性の書き込み" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvDelete" Content="削除" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvDeleteSub" Content="サブフォルダーとファイルの削除" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadPerm" Content="アクセス許可の読み取り" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvChangePerm" Content="アクセス許可の変更" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvTakeOwnership" Content="所有権の取得" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvSync" Content="同期 (Synchronize)" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="SecModalCancelButton" Content="キャンセル" Height="32" Width="90" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="SecModalCancel_Click"/>
                        <Button x:Name="SecModalApplyButton" Content="変更を保存" Height="32" Width="100" Style="{StaticResource FluentButtonPrimary}" Click="SecModalApply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL 2: HUMAN-FRIENDLY DIFF REVIEW MODAL                -->
        <!-- ======================================================== -->
        <Grid x:Name="DiffModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="980" Height="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Subtitle -->
                        <RowDefinition Height="*"/>    <!-- Diff Table -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚖️ 移行前後 変化点差分レビュー (Diff)" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                            <TextBlock Text=" - Before ➔ After 全体整合性インスペクター" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Click="DiffModalClose_Click"/>
                    </Grid>

                    <!-- Summary Stats Strip -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DiffSummaryStatsText" Text="📊 差分項目: 0件" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Diff DataGrid -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
                        <DataGrid x:Name="DiffReviewDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="None" RowHeight="32"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="変化の種別" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <Border Background="{Binding DiffTypeBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DiffType}" FontWeight="Bold" FontSize="10" Foreground="{Binding DiffTypeBadgeForeground}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="現行サーバー (Before)" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding SourcePath}" FontWeight="Bold" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SourceDetail}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="新環境設計 (After)" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding TargetPath}" FontWeight="Bold" FontSize="11" Foreground="#0284C7" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TargetDetail}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="権限 (ACL) 差分詳細" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <TextBlock Text="{Binding FormattedAclChanges}" FontSize="11" Foreground="#1E293B" Margin="6,4" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="DiffModalCloseButton" Content="閉じる" Height="32" Width="80" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="DiffModalClose_Click"/>
                        <Button x:Name="DiffExportExcelButton" Content="📊 差分レポートをExcel出力" Height="32" Style="{StaticResource FluentButtonPrimary}" Click="DiffExportExcel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL 3: SETTINGS MODAL (環境設定: キャッシュ共有・保存先)   -->
        <!-- ======================================================== -->
        <Grid x:Name="SettingsModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- Description -->
                        <RowDefinition Height="*"/>    <!-- Settings Body -->
                        <RowDefinition Height="Auto"/> <!-- Actions -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="SettingsTitleText" Text="⚙️ 環境設定 (Settings)" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="SettingsDescText" Text="キャッシュ、スナップショット履歴、監査レポートの参照先および保存先を構成します。" FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Settings Body -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,16">
                        <!-- Read Cache Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="SettingsReadTitleText" Text="📂 キャッシュ・スナップショット 参照先 (読み込み)" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                                <TextBlock x:Name="SettingsReadDescText" Text="共有ファイルサーバー上のマスターキャッシュ（UNCパス等）を指定すると、チーム共通の0秒ツリーや推移履歴を参照できます。" FontSize="11" Foreground="#64748B" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsReadPathTextBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12"
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                             ToolTip="空の場合はローカル既定値 (%LocalAppData%\FolderMorpher) を参照します"/>
                                    <Button x:Name="SettingsBrowseReadButton" Grid.Column="1" Content="参照..." Margin="8,0,0,0" Width="70" Height="32"
                                            Style="{StaticResource FluentButtonSecondary}" Click="SettingsBrowseReadButton_Click"/>
                                </Grid>
                                <CheckBox x:Name="SettingsFallbackCheckBox" Content="共有参照先にアクセスできない場合は自動でローカルキャッシュを参照する"
                                          IsChecked="True" FontSize="11.5" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Write Cache Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="SettingsWriteTitleText" Text="💾 キャッシュ・スナップショット 保存先 (書き込み)" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                                <TextBlock x:Name="SettingsWriteDescText" Text="自身がスキャンした結果のツリーキャッシュおよび履歴データの保存場所を選択します。" FontSize="11" Foreground="#64748B" Margin="0,2,0,8" TextWrapping="Wrap"/>

                                <RadioButton x:Name="SettingsWriteModeLocalRadio" GroupName="WriteMode" IsChecked="True" Margin="0,2,0,4"
                                             Checked="SettingsWriteModeRadio_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SettingsWriteLocalText" Text="ローカルに保存" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock x:Name="SettingsWriteLocalSubText" Text=" (推奨: マスターキャッシュを上書きしない安全設定)" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="SettingsWriteModeSameRadio" GroupName="WriteMode" Margin="0,2,0,4"
                                             Checked="SettingsWriteModeRadio_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SettingsWriteSameText" Text="参照先と同じフォルダーに保存" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock x:Name="SettingsWriteSameSubText" Text=" (管理者・マスター更新者用)" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="SettingsWriteModeCustomRadio" GroupName="WriteMode" Margin="0,2,0,4"
                                             Checked="SettingsWriteModeRadio_Checked">
                                    <TextBlock x:Name="SettingsWriteCustomText" Text="任意のカスタムフォルダーを指定" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                </RadioButton>

                                <Grid x:Name="SettingsCustomPathGrid" Margin="22,6,0,0" IsEnabled="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsCustomPathTextBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="11.5"
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                    <Button x:Name="SettingsBrowseCustomButton" Grid.Column="1" Content="参照..." Margin="8,0,0,0" Width="70" Height="30"
                                            Style="{StaticResource FluentButtonSecondary}" Click="SettingsBrowseCustomButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SettingsCancelButton" Content="キャンセル" Width="90" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource FluentButtonSecondary}" Click="SettingsCancelButton_Click"/>
                        <Button x:Name="SettingsSaveButton" Content="設定を保存" Width="100" Height="32"
                                Style="{StaticResource FluentButtonPrimary}" Click="SettingsSaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

            <!-- TOAST NOTIFICATION -->
            <Border x:Name="ToastNotificationBorder" Background="#0F172A" CornerRadius="6" Padding="14,10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡 " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastNotificationText" Text="通知メッセージ" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- GLOBAL FOOTER / STATUS BAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Text="準備完了" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <ProgressBar x:Name="GlobalProgressBar" Height="4" Width="140" Margin="12,0,0,0" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed" Foreground="{StaticResource AccentSky}" Background="#F1F5F9" BorderThickness="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FolderMorpher v1.4.1 - Storage &amp; Migration Studio" FontSize="11.5" Foreground="{StaticResource TextSubtle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
