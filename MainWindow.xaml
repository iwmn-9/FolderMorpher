<Window x:Class="AstraSize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstraSize"
        xmlns:views="clr-namespace:AstraSize.Views"
        xmlns:models="clr-namespace:AstraSize.Models"
        xmlns:eff="clr-namespace:FolderMorpher.Models"
        mc:Ignorable="d"
        Title="FolderMorpher - Storage Monitor &amp; Migration Studio"
        Height="920" Width="1480"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBackground}"
        FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Collapsible Navigation Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Main Content Work Area -->
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT COLLAPSIBLE NAVIGATION SIDEBAR -->
        <Border Grid.Column="0" x:Name="SidebarBorder" Width="220" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>   <!-- Header (Brand & Toggle) -->
                    <RowDefinition Height="*"/>    <!-- Nav List -->
                    <RowDefinition Height="Auto"/> <!-- Footer / Version -->
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,0,14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SidebarToggleButton" Content="☰" Width="34" Height="34"
                                Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#475569"
                                Cursor="Hand" Click="SidebarToggleButton_Click" ToolTip="サイドバーの開閉 (収縮 / 展開)"/>
                        <StackPanel x:Name="SidebarBrandPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Border Background="#EFF6FF" CornerRadius="6" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FolderMorpher" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                <TextBlock Text="Storage &amp; Migration" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Nav Items -->
                <StackPanel Grid.Row="1" Margin="10,14">
                    <RadioButton x:Name="NavTabStorage" Style="{StaticResource SidebarNavButton}"
                                 IsChecked="True" Checked="NavTab_Checked" Tag="📊" Content="容量分析 &amp; 監視" ToolTip="📊 容量分析 &amp; 監視"/>
                    <RadioButton x:Name="NavTabLiveAcl" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🛡️" Content="権限コントロール" ToolTip="🛡️ 実環境 権限コントロール"/>
                    <RadioButton x:Name="NavTabSimulation" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🚀" Content="移行スタジオ" ToolTip="🚀 移行シミュレーション"/>
                    <RadioButton x:Name="NavTabLinkFix" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🔗" Content="リンク一括修復" ToolTip="🔗 ショートカット・Office修復"/>
                    <RadioButton x:Name="NavTabAudit" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🧹" Content="断捨離・健全化" ToolTip="🧹 重複・休眠・パス長チェック"/>
                    <RadioButton x:Name="NavTabMedia" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🖼️" Content="メディア最適化" ToolTip="🖼️ 写真軽量化 &amp; 巨大動画抽出"/>
                </StackPanel>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                    <Grid>
                        <!-- Expanded Footer (2-tier layout: Brand on top, Controls below) -->
                        <StackPanel x:Name="SidebarFooterExpandedPanel" Margin="14,8,14,10">
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="FolderMorpher v1.6.6" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="Storage &amp; Migration Studio" FontSize="10" Foreground="#94A3B8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SettingsButton" Content="⚙️" Height="24" Width="28" FontSize="11" Margin="0,0,6,0" Padding="0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="SettingsButton_Click" ToolTip="環境設定 / Settings"/>
                                <Button x:Name="LanguageToggleButton" Content="🌐 EN" Height="24" FontSize="11" FontWeight="Bold" Foreground="#2563EB" Padding="8,2"
                                        Style="{StaticResource FluentButtonSecondary}" Click="LanguageToggleButton_Click" ToolTip="言語切り替え / Switch Language (JA / EN)"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Collapsed Footer (Mini Vertical Stack) -->
                        <StackPanel x:Name="SidebarFooterCollapsedPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,6,0,10">
                            <Button x:Name="SettingsButtonMini" Content="⚙️" Width="34" Height="26" FontSize="11" Margin="0,0,0,4"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SettingsButton_Click" ToolTip="環境設定 / Settings"/>
                            <Button x:Name="LanguageToggleButtonMini" Content="🌐" Width="34" Height="26" FontSize="11" FontWeight="Bold" Foreground="#2563EB"
                                    Style="{StaticResource FluentButtonSecondary}" Click="LanguageToggleButton_Click" ToolTip="言語切り替え / Switch Language"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2. RIGHT MAIN WORK AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- Tab Views Container -->
                <RowDefinition Height="Auto"/> <!-- Global Footer / Status Bar -->
            </Grid.RowDefinitions>

            <!-- TAB VIEWS CONTAINER -->
            <Grid Grid.Row="0">
            <!-- ======================================================== -->
            <!-- TAB 1: STORAGE EXPLORER (容量分析 & マルチタブ)           -->
            <!-- ======================================================== -->
            <Grid x:Name="StorageTabPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Multi-Tab Header Strip -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar & Path -->
                    <RowDefinition Height="Auto"/> <!-- Key Metrics Cards -->
                    <RowDefinition Height="*"/>    <!-- Split View (Tree & Insights) -->
                </Grid.RowDefinitions>

                <!-- Multi-Tab Strip -->
                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="16,6,16,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="StorageTabsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ScanTabModel}">
                                        <Border Margin="0,0,4,0" CornerRadius="6,6,0,0" Padding="12,6" Cursor="Hand"
                                                MouseDown="StorageTabItem_MouseDown" Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TabTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                <Button Content="✕" Margin="8,0,0,0" Width="16" Height="16" FontSize="10"
                                                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                        Click="CloseStorageTabButton_Click" Tag="{Binding}" Cursor="Hand" ToolTip="タブを閉じる"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="AddStorageTabButton" Content="＋ 新しいタブ" Height="26" Margin="4,0,0,0"
                                    Style="{StaticResource FluentButtonSecondary}" Padding="8,2" FontSize="12"
                                    Click="AddStorageTabButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Storage Toolbar -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍 " Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox x:Name="PathTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource MonoFont}"
                                         Foreground="#0F172A" KeyDown="PathTextBox_KeyDown"/>
                            </Grid>
                        </Border>

                        <Button x:Name="StorageBrowseButton" Grid.Column="1" Content="参照..." Margin="8,0,0,0" Height="32"
                                Style="{StaticResource FluentButtonSecondary}" Click="BrowseButton_Click"/>

                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Width="160" Margin="10,0,10,0" Padding="8,0">
                            <TextBox x:Name="FilterTextBox" BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" FontSize="12.5" Foreground="#0F172A"
                                     TextChanged="FilterTextBox_TextChanged"/>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button x:Name="ScanButton" Content="スキャン開始" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="ScanButton_Click"/>
                            <Button x:Name="CancelButton" Content="中止" Height="32" Margin="0,0,8,0" Background="#E11D48"
                                    Style="{StaticResource FluentButtonPrimary}" Visibility="Collapsed" Click="CancelButton_Click"/>
                            <Button x:Name="ExportButton" Content="Excel / CSV 出力" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="ExportButton_Click"/>
                            <Button x:Name="TabHistoryButton" Content="📈 容量推移グラフ" Height="32"
                                    Style="{StaticResource FluentButtonSecondary}" Click="HistoryButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metrics Cards -->
                <Border Grid.Row="2" Background="{StaticResource CanvasBackground}" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="StorageKpiScannedSizeTitle" Text="スキャン対象容量" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    <Border x:Name="MftBoostBadge" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="⚡ MFT Boost" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="ScannedSizeTextBlock" Text="0.00 GB" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TotalFilesTextBlock" Text="0 ファイル / 0 フォルダ" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock x:Name="StorageKpiLargestFileTitle" Text="最大ファイル (Top 1)" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="LargestFileSizeTextBlock" Text="--" FontSize="22" FontWeight="Bold" Foreground="#E11D48" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LargestFileNameTextBlock" Text="--" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock x:Name="StorageKpiDiffTrendTitle" Text="前回スキャンとの差分推移" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TrendDiffTextBlock" Text="比較データなし" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentSky}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LastScanDateTextBlock" Text="初回スキャン" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Storage Split View (Tree & Insights) -->
                <Grid Grid.Row="3" Margin="20,0,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: TreeGrid Card -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <DataGrid x:Name="FileTreeDataGrid"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="36"
                                  SelectionMode="Single"
                                  SelectionChanged="FileTreeDataGrid_SelectionChanged"
                                  MouseDoubleClick="FileTreeDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📂 エクスプローラーで開く" Click="CtxOpenExplorer_Click"/>
                                    <MenuItem Header="📋 パスをコピー" Click="CtxCopyPath_Click"/>
                                    <MenuItem Header="🔍 このフォルダーをルートにしてスキャン" Click="CtxScanSubtree_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🛡️ このフォルダーのNTFS権限を確認・編集" Click="CtxEditAcl_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="ColTreeName" Header="名前" Width="3.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:FileItemNode}">
                                            <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                                <Button Width="16" Height="16" Margin="0,0,4,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Click="ExpandCollapseButton_Click" Tag="{Binding}"
                                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ExpandIcon}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                </Button>
                                                <TextBlock Text="{Binding IconGlyph}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="{Binding FontWeight}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColTreeSize" Header="容量" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:FileItemNode}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding FormattedSize}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                <Border Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}" Background="{Binding DiffBadgeBackground}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DiffFormatted}" FontSize="10" FontWeight="Bold" Foreground="{Binding DiffBadgeForeground}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColTreeShare" Header="全体占有率" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:FileItemNode}">
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding SharePercentage}"
                                                             Foreground="{Binding SharePercentage, Converter={StaticResource PercentageToBarBrush}}"
                                                             Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"
                                                             Visibility="{Binding IsDriveRoot, Converter={StaticResource InverseBoolToVis}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ShareFormatted}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColTreeCount" Header="ファイル数" Binding="{Binding FileCount, StringFormat='{}{0:N0}'}" Width="80" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColTreeModified" Header="最終更新" Binding="{Binding LastModified, StringFormat='yyyy/MM/dd HH:mm'}" Width="120" ElementStyle="{StaticResource LeftAlignedCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- Right: Insights & Extensions -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top 10 Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock x:Name="StorageTopFilesTitleText" Text="💡 容量上位ファイル (Top 10)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock x:Name="InsightsTargetScopeTextBlock" Text="スコープ: 全体" FontSize="11" Foreground="#0284C7" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>

                            <!-- Top 10 Largest Files DataGrid -->
                            <DataGrid x:Name="TopFilesDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" Background="Transparent" RowHeight="28" GridLinesVisibility="None" SelectionMode="Single" Margin="0,0,0,10"
                                      MouseDoubleClick="TopFilesDataGrid_MouseDoubleClick" ToolTip="ダブルクリックでエクスプローラーを開く">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📂 エクスプローラーで表示" Click="CtxTopFileOpenExplorer_Click"/>
                                        <MenuItem Header="📋 パスをコピー" Click="CtxTopFileCopyPath_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColTopFileName" Header="ファイル名" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                    <DataGridTextColumn x:Name="ColTopFileSize" Header="サイズ" Binding="{Binding FormattedSize}" Width="75" ElementStyle="{StaticResource RightAlignedCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Folder Direct Children Shares Header -->
                            <Grid Grid.Row="2" Margin="0,6,0,6">
                                <TextBlock x:Name="StorageDirectSharesTitleText" Text="📁 選択フォルダの内訳 (直下シェア)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock x:Name="StorageDirectSharesSubText" Text="Wクリックでツリー連動 ➔" FontSize="11" Foreground="#0284C7" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Folder Direct Children Shares DataGrid -->
                            <DataGrid x:Name="FolderChildSharesDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" Background="Transparent" RowHeight="28" GridLinesVisibility="None" SelectionMode="Single"
                                      MouseDoubleClick="FolderChildSharesDataGrid_MouseDoubleClick" ToolTip="ダブルクリックで該当フォルダへドリルダウン">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="ColShareName" Header="項目名" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FolderChildShareItem}">
                                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="ColShareSize" Header="容量" Binding="{Binding FormattedSize}" Width="75" ElementStyle="{StaticResource RightAlignedCell}"/>
                                    <DataGridTemplateColumn x:Name="ColShareRatio" Header="直下シェア" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FolderChildShareItem}">
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding RelativeSharePercentage}"
                                                                 Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding RelativeShareFormatted}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 2: LIVE ACL CONTROL (実環境 権限マネージャー)         -->
            <!-- ======================================================== -->
            <views:LiveAclStudio x:Name="LiveAclStudioControl" Visibility="Collapsed"/>
            <!-- ======================================================== -->
            <!-- TAB 3: MIGRATION SIMULATION STUDIO (FolderMorph Studio)   -->
            <!-- ======================================================== -->
            <Grid x:Name="SimulationTabPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Studio Action Toolbar -->
                    <RowDefinition Height="*"/>    <!-- 3-Pane Split View -->
                </Grid.RowDefinitions>

                <!-- Studio Action Toolbar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Project Info -->
                            <ColumnDefinition Width="*"/>    <!-- Target Path Settings -->
                            <ColumnDefinition Width="Auto"/> <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <!-- Project info -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="🚀" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SimProjectNameTextBox" Text="新ファイルサーバー移行設計_Ver1" FontWeight="Bold" FontSize="12"
                                     Foreground="#0F172A" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Target folder setting for skeleton -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" MinWidth="260" Padding="10,0" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SimTargetRootLabel" Text="📁 移行先ルート: " Foreground="#64748B" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="SimTargetRootTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}" Text="\\NewServer01\Share"/>
                                <Button x:Name="SimTargetBrowseButton" Grid.Column="2" Content="参照..." Background="Transparent" BorderThickness="0" Foreground="#0284C7" FontSize="11" Click="SimTargetBrowse_Click"/>
                            </Grid>
                        </Border>

                        <!-- Toolbar Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SimSaveProjectButton" Content="💾 保存" Height="32" Margin="0,0,5,0" Padding="8,4" FontSize="11"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimSaveProjectButton_Click" ToolTip="プロジェクト保存 (.fmorph)"/>
                            <Button x:Name="SimLoadProjectButton" Content="📂 読込" Height="32" Margin="0,0,5,0" Padding="8,4" FontSize="11"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimLoadProjectButton_Click" ToolTip="プロジェクト読込"/>
                            <Button x:Name="SimDiffReviewButton" Content="🔍 チェック" Height="32" Margin="0,0,5,0" Padding="10,4" FontSize="11"
                                    Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimDiffReviewButton_Click" ToolTip="変化点差分インスペクター"/>
                            <Button x:Name="SimDeploySkeletonButton" Content="🚀 スケルトン作成" Height="32" Margin="0,0,5,0" Padding="10,4" FontSize="11"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimDeploySkeletonButton_Click" ToolTip="空フォルダ階層と設計済みNTFSアクセス権を新環境へ先行展開"/>
                            <Button x:Name="SimExportScriptsButton" Content="⚙️ 移行スクリプト" Height="32" Margin="0,0,5,0" Padding="8,4" FontSize="11"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimExportScriptsButton_Click" ToolTip="Robocopy / FastCopy スクリプト生成"/>
                            <Button x:Name="SimExportExcelButton" Content="📊 Excel設計書" Height="32" Padding="8,4" FontSize="11"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimExportExcelButton_Click" ToolTip="移行設計書Excel出力"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3-Pane Split View -->
                <!-- 4-Column Horizontal Workflow Layout -->
                <Grid Grid.Row="1" Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.3*" MinWidth="180"/> <!-- Col 0: Pane 1: Source Explorer -->
                        <ColumnDefinition Width="10"/>                  <!-- Col 1: Splitter -->
                        <ColumnDefinition Width="3.1*" MinWidth="220"/> <!-- Col 2: Pane 2: Mock TreeView -->
                        <ColumnDefinition Width="10"/>                  <!-- Col 3: Splitter -->
                        <ColumnDefinition Width="3.2*" MinWidth="240"/> <!-- Col 4: Pane 3: Folder Inspector -->
                        <ColumnDefinition Width="10"/>                  <!-- Col 5: Splitter -->
                        <ColumnDefinition Width="2.4*" MinWidth="180"/> <!-- Col 6: Pane 4: AD Palette -->
                    </Grid.ColumnDefinitions>

                    <!-- ============================================== -->
                    <!-- PANE 1: SOURCE SERVER EXPLORER                 -->
                    <!-- ============================================== -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="SimSourceTitleText" Text="① 現行ファイルサーバー (移行元)" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                <TextBlock x:Name="SimSourceSubText" Text="サブフォルダを掴んで新ツリーへ直接ドロップ" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Path, Browse & Load -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Height="28" Padding="6,0">
                                    <TextBox x:Name="SimSourcePathTextBox" BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                                <Button x:Name="SimSourceBrowseButton" Grid.Column="1" Content="参照..." Height="28" Margin="6,0,0,0"
                                        Style="{StaticResource FluentButtonSecondary}" Padding="8,2" Click="SimSourceBrowseButton_Click" ToolTip="現行フォルダ（UNCまたはローカル）を参照選択"/>
                                <Button x:Name="SimSourceLoadButton" Grid.Column="2" Content="読込" Height="28" Margin="4,0,0,0"
                                        Style="{StaticResource FluentButtonSecondary}" Padding="10,2" Click="SimSourceLoadButton_Click"/>
                            </Grid>

                            <!-- Source TreeView (Draggable, Smooth Scroll & Lazy Loading) -->
                            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Background="#F8FAFC">
                                <TreeView x:Name="SimSourceTreeView" BorderThickness="0" Background="Transparent"
                                          ScrollViewer.CanContentScroll="False"
                                          SelectedItemChanged="SimSourceTreeView_SelectedItemChanged"
                                          PreviewMouseMove="SimSourceTreeView_PreviewMouseMove">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                            <EventSetter Event="Expanded" Handler="SimSourceTreeViewItem_Expanded"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="📁 " FontSize="11"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="10"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>

                            <!-- Clone Button -->
                            <Button Grid.Row="3" x:Name="SimCloneSelectedButton" Content="➡️ 選択フォルダを新設配置" Height="30" Margin="0,8,0,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimCloneSelectedButton_Click" FontSize="11"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- ============================================== -->
                    <!-- PANE 2: MOCK TREE (新ツリー構造設計)             -->
                    <!-- ============================================== -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="SimMockTreeTitleText" Text="② 新環境 仮想フォルダツリー" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                    <TextBlock x:Name="SimMockTreeSubText" Text="💡 フォルダ行にドロップでサブ化 / クイックボタンで階層変更" FontSize="10" Foreground="#0284C7"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="SimAddRootFolderButton" Content="＋ ルート新設" Height="26" Style="{StaticResource FluentButtonSecondary}"
                                            FontSize="10.5" Padding="6,2" Click="SimAddRootFolderButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Mock TreeView with Drop & ContextMenu (Smooth Scroll & Smooth Drag) -->
                            <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#FFFFFF">
                                <TreeView x:Name="SimMockTreeView" BorderThickness="0" Background="Transparent"
                                          ScrollViewer.CanContentScroll="False"
                                          SelectedItemChanged="SimMockTreeView_SelectedItemChanged"
                                          AllowDrop="True"
                                          Drop="SimMockTreeView_Drop"
                                          DragOver="SimMockTreeView_DragOver"
                                          PreviewMouseLeftButtonDown="SimMockTreeView_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="SimMockTreeView_PreviewMouseMove">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📁 新規サブフォルダ作成" Click="CtxSimAddChild_Click"/>
                                            <MenuItem Header="✏️ フォルダ名の変更" Click="CtxSimRename_Click"/>
                                            <Separator/>
                                            <MenuItem Header="⏮ 第1階層（ルート）へ昇格" Click="CtxSimJumpRoot_Click"/>
                                            <MenuItem Header="◀ 1階層昇格" Click="CtxSimPromote_Click"/>
                                            <MenuItem Header="▶ 1階層降格 (サブ化)" Click="CtxSimDemote_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🗑️ 削除" Click="CtxSimDelete_Click"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Border CornerRadius="4" Padding="4,3" Margin="0,1" Background="Transparent">
                                                <Grid Margin="{Binding IndentMargin}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Icon & Name -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Level Pill -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Mapping Badge -->
                                                        <ColumnDefinition Width="*"/>    <!-- Quick Level Buttons -->
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Margin="6,0,0,0" CornerRadius="3" Padding="4,1"
                                                            Background="{Binding LevelPillBackground}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LevelPillText}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding LevelPillForeground}"/>
                                                    </Border>

                                                    <Border Grid.Column="2" Margin="4,0,0,0" CornerRadius="3" Padding="4,1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                                            VerticalAlignment="Center" Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding MappingBadgeText}" FontSize="9.5" Foreground="#B45309"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="⏮" Width="18" Height="18" Padding="0" FontSize="9" ToolTip="第1階層(ルート)へ一気ジャンプ"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="1,0" Click="SimQuickJumpRoot_Click" Tag="{Binding}"/>
                                                        <Button Content="◀" Width="18" Height="18" Padding="0" FontSize="9" ToolTip="1階層昇格"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="1,0" Click="SimQuickPromote_Click" Tag="{Binding}"/>
                                                        <Button Content="▶" Width="18" Height="18" Padding="0" FontSize="9" ToolTip="1階層降格"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="1,0" Click="SimQuickDemote_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- ============================================== -->
                    <!-- PANE 3: FOLDER INSPECTOR (マッピング ＆ 権限)     -->
                    <!-- ============================================== -->
                    <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Selected Folder Info -->
                                <RowDefinition Height="*"/>    <!-- Inspector Scrollable Area -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Selected Folder Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="③ フォルダ詳細 ＆ 権限設定" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                <Grid Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SimSelectedFolderPrefixText" Text="📁 " FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                                        <TextBlock x:Name="SimSelectedFolderNameText" Text="(未選択 - 左のフォルダをクリック)" FontWeight="Bold" FontSize="12" Foreground="#0284C7" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SimInheritCheckBox" Content="親の権限継承" HorizontalAlignment="Right"
                                              FontSize="11" Checked="SimInheritCheckBox_Changed" Unchecked="SimInheritCheckBox_Changed"/>
                                </Grid>
                            </StackPanel>

                            <!-- Row 1: Inspector Scrollable Area (広域ドロップ受容) -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10"
                                    AllowDrop="True" Drop="SimAccordion_Drop" DragOver="SimGenericDragOver">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Drop Zone 1: Subfolder Maker -->
                                        <Border Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1"
                                                CornerRadius="4" Padding="8,5" Margin="0,0,0,8" AllowDrop="True"
                                                Drop="SimSubfolderDropZone_Drop" DragOver="SimGenericDragOver">
                                            <TextBlock x:Name="SimSubfolderDropHintText" Text="📥 左の現行フォルダをここにドロップして直下にサブ化"
                                                       FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Drop Zone 2: N:1 Source Mapping Area -->
                                        <Border Background="#FAF5FF" BorderBrush="#C084FC" BorderThickness="1"
                                                CornerRadius="4" Padding="8" Margin="0,0,0,8" AllowDrop="True"
                                                Drop="SimMappingDropZone_Drop" DragOver="SimGenericDragOver">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock x:Name="SimMappingTitleText" Text="🔗 移行元マッピング (データ移行元 / N:1統合)" FontSize="11" FontWeight="Bold" Foreground="#7E22CE"/>
                                                </Grid>
                                                <!-- List of mapped sources -->
                                                <ItemsControl x:Name="SimMappedSourcesItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FFFFFF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2"
                                                                    Cursor="Hand" MouseDown="SimMappedSource_MouseDown" PreviewMouseMove="SimMappedSource_PreviewMouseMove">
                                                                <TextBlock Text="{Binding StringFormat='🔗 {0}'}" FontSize="10.5" FontFamily="{StaticResource MonoFont}" Foreground="#4C1D95" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Drop Zone 3: AD Permissions Cards Area -->
                                        <Border Background="#F0F9FF" BorderBrush="#38BDF8" BorderThickness="1"
                                                CornerRadius="4" Padding="8" AllowDrop="True"
                                                Drop="SimAclDropZone_Drop" DragOver="SimGenericDragOver">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock x:Name="SimAclTitleText" Text="🛡️ 割り当てられたADアクセス権" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                                    <Button x:Name="SimOpenSecModalButton" Content="⚙️ 詳細設定" FontSize="10" Height="20" Padding="5,0"
                                                            Style="{StaticResource FluentButtonSecondary}" HorizontalAlignment="Right"
                                                            Click="SimOpenSecModalButton_Click"/>
                                                </Grid>
                                                <!-- Permissions Cards Grid (縦リストで視認性向上) -->
                                                <ItemsControl x:Name="SimAclCardsItemsControl">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Vertical"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:SimAclEntry}">
                                                            <Border Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4"
                                                                    Padding="8,5" Margin="0,0,0,4" Cursor="Hand"
                                                                    MouseDown="SimAclCard_MouseDown"
                                                                    PreviewMouseMove="SimAclCard_PreviewMouseMove">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <!-- Row 0: アイコン ＋ 表示名 (横幅いっぱい) -->
                                                                    <Grid Grid.Row="0" Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11.5" Foreground="#0F172A" 
                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                                    </Grid>
                                                                    <!-- Row 1: 権限バッジ ＋ 適用先バッジ -->
                                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <Border Background="#E0F2FE" CornerRadius="3" Padding="5,1.5" Margin="0,0,4,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FormattedRights}" FontSize="10" Foreground="#0284C7"/>
                                                                        </Border>
                                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="5,1.5" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding AppliesTo}" FontSize="9.5" Foreground="#64748B"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="5" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- ============================================== -->
                    <!-- PANE 4: AD PALETTE (USERS & GROUPS)            -->
                    <!-- ============================================== -->
                    <Border Grid.Column="6" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock x:Name="SimAdHeaderTitle" Text="④ AD パレット" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                    <Border x:Name="DomainStatusBadge" Background="#DCFCE7" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="DomainStatusText" Text="🟢 CORP.LOCAL" FontSize="10" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="SimAdHeaderSubText" Text="カードを中央のフォルダまたは詳細へドラッグ" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="30" Padding="6,0" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍 " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AdSearchTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" FontSize="11" TextChanged="AdSearchTextBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AdPrincipalsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:AdPrincipalItem}">
                                                <Border Background="{Binding BadgeBackground}" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="6" Padding="8,5" Margin="0,0,0,4" Cursor="Hand"
                                                        PreviewMouseMove="AdCard_PreviewMouseMove" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- Row 0: アイコン ＋ 表示名 (横幅100%活用) -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F172A" 
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                        </Grid>
                                                        <!-- Row 1: アカウント名 ＋ 種別バッジ -->
                                                        <Grid Grid.Row="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding AccountName}" FontSize="10" Foreground="#64748B" 
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding AccountName}" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Background="{Binding TypeBadgeBg}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                <TextBlock Text="{Binding TypeBadgeText}" FontSize="9.5" Foreground="{Binding TypeBadgeFg}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 3: LINK FIXER (ショートカット＆リンク一括修復)        -->
            <!-- ======================================================== -->
            <Grid x:Name="LinkFixTabPanel" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock x:Name="LinkFixHeaderTitle" Text="🔗 サーバー移行に伴うショートカット (LNK) / パス参照の一括修復" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="LinkFixHeaderDesc" Text="ファイルサーバー移行後、旧パス（例: \\OldServer\Share）を指したまま切断されたショートカットを一括検出し、新パスへ安全に書き換えます。"
                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="LinkSearchScopeLabel" Text="検索対象フォルダ (デスクトップ等)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" Padding="10,0">
                                    <TextBox x:Name="LinkSearchScopeTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock x:Name="LinkOldPatternLabel" Text="置換前 (旧サーバー名 / パス)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" Padding="10,0">
                                    <TextBox x:Name="LinkOldPatternTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LinkNewPatternLabel" Text="置換後 (新サーバー名 / パス)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" Padding="10,0">
                                    <TextBox x:Name="LinkNewPatternTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="LinkIncludeOfficeCheckBox" Content="Officeファイル内部リンク (.xlsx/.xlsm) も対象に含める" IsChecked="True" VerticalAlignment="Center" FontSize="11" Foreground="#475569"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="LinkGenerateGpoButton" Content="📜 GPOログオンスクリプト生成 (.ps1)" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="LinkGenerateGpoButton_Click" ToolTip="全社PCのデスクトップ/マイドキュメント等のショートカットを自動修復するスクリプトを出力"/>
                                <Button x:Name="LinkScanButton" Content="切断リンク検出スキャン" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="LinkScanButton_Click"/>
                                <Button x:Name="LinkFixExecuteButton" Content="🔍 チェック" Height="32"
                                        Style="{StaticResource FluentButtonPrimary}" Click="LinkFixExecuteButton_Click"
                                        ToolTip="修復対象のショートカット一覧と置換差分をチェック"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LinkTableTitleText" Grid.Row="0" Text="検出されたショートカット一覧" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <DataGrid x:Name="LinkItemsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="None" RowHeight="30" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColLinkFileName" Header="ファイル名" Binding="{Binding FileName}" Width="160" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColLinkFileType" Header="種別" Binding="{Binding FileType}" Width="120" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColLinkOldTarget" Header="現在のターゲットパス" Binding="{Binding OldTarget}" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColLinkNewTarget" Header="置換後ターゲットパス" Binding="{Binding NewTarget}" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColLinkStatus" Header="状態" Binding="{Binding Status}" Width="130" ElementStyle="{StaticResource LeftAlignedCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 5: AUDIT & HYGIENE (断捨離・ファイルサーバー健全化)       -->
            <!-- ======================================================== -->
            <Grid x:Name="AuditTabPanel" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Controls Card -->
                    <RowDefinition Height="Auto"/> <!-- KPI Summary Cards -->
                    <RowDefinition Height="*"/>    <!-- Results DataGrid -->
                </Grid.RowDefinitions>

                <!-- Controls Card -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="AuditHeaderTitle" Text="🧹 ファイルサーバー健全化 ＆ 断捨離（衛生監査・容量削減）" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="AuditHeaderDesc" Text="重複ファイル (SHA256)、休眠ファイル (3年以上未更新)、パス長240文字超、移行禁則文字を一括抽出し、安全な棚卸し台帳や退避スクリプトを生成します。"
                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="AuditTargetFolderLabel" Text="監査対象ディレクトリ (UNC / ローカル)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" Padding="10,0">
                                        <TextBox x:Name="AuditPathTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                                    </Border>
                                    <Button x:Name="AuditBrowseButton" Grid.Column="1" Content="📁 参照" Width="96" Height="34" Margin="8,0,0,0"
                                            Style="{StaticResource FluentButtonSecondary}" Click="AuditBrowseButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <CheckBox x:Name="AuditCheckDuplicatesCheckBox" Content="重複ファイル (SHA256)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" Foreground="#334155"/>
                                <CheckBox x:Name="AuditCheckDormantCheckBox" Content="休眠ファイル (3年以上)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" Foreground="#334155"/>
                                <CheckBox x:Name="AuditCheckPathLimitsCheckBox" Content="パス長260字超/禁則文字" IsChecked="True" VerticalAlignment="Center" FontSize="12" Foreground="#334155"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="AuditStatusText" Text="待機中" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="AuditExportExcelButton" Content="📊 Excelレポート出力 (.xlsx)" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="AuditExportExcelButton_Click" ToolTip="上司・各部署提出用の美麗Excelレポートを生成"/>
                                <Button x:Name="AuditExportCsvButton" Content="📄 CSV台帳出力" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="AuditExportCsvButton_Click"/>
                                <Button x:Name="AuditGenArchiveScriptButton" Content="📦 安全退避バッチ生成 (.bat)" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="AuditGenArchiveScriptButton_Click" ToolTip="休眠・重複ファイルを安全に別フォルダへ退避するスクリプトを出力"/>
                                <Button x:Name="AuditDeleteSelectedButton" Content="🗑️ 選択ファイルを完全削除" Height="32" Margin="0,0,8,0"
                                        Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                        Style="{StaticResource FluentButtonPrimary}" Click="AuditDeleteSelectedButton_Click"
                                        ToolTip="チェックを入れたファイルを直接完全削除します（※復元不可）"/>
                                <Button x:Name="AuditStartButton" Content="🔍 監査スキャン開始" Height="32"
                                        Style="{StaticResource FluentButtonPrimary}" Click="AuditStartButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- KPI Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="AuditKpiTotalFilesTitle" Text="総走査ファイル数" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="AuditKpiTotalFiles" Text="0 件" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="AuditKpiDupWastedTitle" Text="重複ファイルによる無駄" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="AuditKpiDupWasted" Text="0 B" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="AuditKpiDormantSizeTitle" Text="休眠ファイル容量 (3年超)" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="AuditKpiDormantSize" Text="0 B" FontSize="18" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="AuditKpiPathLimitsTitle" Text="パス長超過 / 禁則文字" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="AuditKpiPathLimits" Text="0 件" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Results DataGrid -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AuditTableTitleText" Grid.Column="0" Text="検出された課題・断捨離候補一覧" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#FEE2E2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AuditLiveReductionLabel" Text="選択中の削減見込み: " FontSize="11" Foreground="#991B1B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AuditLiveSelectedReductionText" Text="0 B (0 件)" FontSize="11" Foreground="#DC2626" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="AuditSmartSelectLabel" Text="☑️ 一括選択:" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="AuditSmartSelectComboBox" Width="170" Height="28" FontSize="11" Margin="0,0,12,0" SelectionChanged="AuditSmartSelectComboBox_SelectionChanged">
                                    <ComboBoxItem Content="選択プリセット..." IsSelected="True" Tag="None"/>
                                    <ComboBoxItem Content="重複の原本以外を選択" Tag="DupCopyOnly"/>
                                    <ComboBoxItem Content="3年以上前の休眠を選択" Tag="Dormant3Y"/>
                                    <ComboBoxItem Content="5年以上前の休眠を選択" Tag="Dormant5Y"/>
                                    <ComboBoxItem Content="表示中のみすべて選択" Tag="SelectVisible"/>
                                    <ComboBoxItem Content="選択をすべて解除" Tag="ClearAll"/>
                                </ComboBox>

                                <TextBlock x:Name="AuditFilterLabel" Text="絞り込み:" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="AuditCategoryFilterComboBox" Width="135" Height="28" FontSize="11.5" Margin="0,0,10,0" SelectionChanged="AuditFilter_Changed">
                                    <ComboBoxItem Content="すべて表示" IsSelected="True" Tag="All"/>
                                    <ComboBoxItem Content="重複ファイルのみ" Tag="Duplicate"/>
                                    <ComboBoxItem Content="休眠ファイルのみ" Tag="Dormant"/>
                                    <ComboBoxItem Content="パス長・禁則のみ" Tag="PathLimit"/>
                                </ComboBox>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="28" Width="180" Padding="6,0">
                                    <Grid>
                                        <TextBox x:Name="AuditSearchFilterTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11.5" TextChanged="AuditFilter_Changed"/>
                                        <TextBlock x:Name="AuditSearchPlaceholder" Text="🔍 ファイル名/パス検索..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=AuditSearchFilterTextBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="AuditItemsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="None" RowHeight="30" HeadersVisibility="Column" RowHeaderWidth="0"
                                  MouseDoubleClick="AuditItemsDataGrid_MouseDoubleClick"
                                  Sorting="AuditItemsDataGrid_Sorting">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding RowBackgroundHex}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="38" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox x:Name="AuditHeaderCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center" Click="AuditHeaderCheckBox_Click" ToolTip="すべて選択 / すべて解除"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColAuditIssueType" Header="問題種別" Binding="{Binding IssueTypeDisplay}" SortMemberPath="IssueType" Width="130" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTemplateColumn x:Name="ColAuditDupGroup" Header="重複グループ" SortMemberPath="DuplicateGroupIndex" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BadgeBackgroundHex}" BorderBrush="{Binding BadgeBorderHex}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="4,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding DuplicateGroupBadge}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{Binding BadgeForegroundHex}" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColAuditFileName" Header="ファイル名" Binding="{Binding FileName}" SortMemberPath="FileName" Width="180" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColAuditSize" Header="容量" Binding="{Binding SizeFormatted}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColAuditModified" Header="最終更新日時" Binding="{Binding LastWriteTime, StringFormat='yyyy/MM/dd HH:mm'}" SortMemberPath="LastWriteTime" Width="130" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColAuditDetail" Header="詳細" Binding="{Binding Detail}" SortMemberPath="Detail" Width="200" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColAuditFullPath" Header="完全パス" Binding="{Binding FullPath}" SortMemberPath="FullPath" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 6: MEDIA OPTIMIZER (写真軽量化 ＆ 巨大動画抽出)        -->
            <!-- ======================================================== -->
            <Grid x:Name="MediaTabPanel" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Controls Card -->
                    <RowDefinition Height="Auto"/> <!-- KPI Summary Cards -->
                    <RowDefinition Height="*"/>    <!-- Results DataGrid -->
                </Grid.RowDefinitions>

                <!-- Controls Card -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="MediaHeaderTitle" Text="🖼️ メディア・オプティマイザ（写真・画像最適化 ＆ 巨大動画攻略）" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="MediaHeaderDesc" Text="聖域（_Master、印刷用、RAW等）を自動保護しながら、大容量写真（2MB超）を最適化（長辺2560px超は縮小/85%品質/Exif・日時保持）で上書き軽量化し、巨大動画のTop抽出と夜間圧縮バッチを出力します。"
                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="MediaTargetDirLabel" Text="走査対象ディレクトリ (UNC / ローカル)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
