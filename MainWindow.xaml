<Window x:Class="AstraSize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstraSize"
        xmlns:models="clr-namespace:AstraSize.Models"
        xmlns:eff="clr-namespace:FolderMorpher.Models"
        mc:Ignorable="d"
        Title="FolderMorpher - Storage Monitor &amp; Migration Studio"
        Height="920" Width="1480"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBackground}"
        FontFamily="{StaticResource MainFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Collapsible Navigation Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Main Content Work Area -->
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT COLLAPSIBLE NAVIGATION SIDEBAR -->
        <Border Grid.Column="0" x:Name="SidebarBorder" Width="220" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>   <!-- Header (Brand & Toggle) -->
                    <RowDefinition Height="*"/>    <!-- Nav List -->
                    <RowDefinition Height="Auto"/> <!-- Footer / Version -->
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,0,14,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SidebarToggleButton" Content="☰" Width="34" Height="34"
                                Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#475569"
                                Cursor="Hand" Click="SidebarToggleButton_Click" ToolTip="サイドバーの開閉 (収縮 / 展開)"/>
                        <StackPanel x:Name="SidebarBrandPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Border Background="#EFF6FF" CornerRadius="6" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="📁" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FolderMorpher" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                <TextBlock Text="Storage &amp; Migration" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Nav Items -->
                <StackPanel Grid.Row="1" Margin="10,14">
                    <RadioButton x:Name="NavTabStorage" Style="{StaticResource SidebarNavButton}"
                                 IsChecked="True" Checked="NavTab_Checked" Tag="📊" Content="容量分析 &amp; 監視" ToolTip="📊 容量分析 &amp; 監視"/>
                    <RadioButton x:Name="NavTabLiveAcl" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🛡️" Content="権限コントロール" ToolTip="🛡️ 実環境 権限コントロール"/>
                    <RadioButton x:Name="NavTabSimulation" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🚀" Content="移行スタジオ" ToolTip="🚀 移行シミュレーション"/>
                    <RadioButton x:Name="NavTabLinkFix" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🔗" Content="リンク一括修復" ToolTip="🔗 ショートカット・Office修復"/>
                    <RadioButton x:Name="NavTabAudit" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🧹" Content="断捨離・健全化" ToolTip="🧹 重複・休眠・パス長チェック"/>
                    <RadioButton x:Name="NavTabMedia" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🖼️" Content="メディア最適化" ToolTip="🖼️ 写真軽量化 &amp; 巨大動画抽出"/>
                </StackPanel>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="14,10">
                    <Grid>
                        <StackPanel x:Name="SidebarFooterPanel" VerticalAlignment="Center">
                            <TextBlock Text="FolderMorpher v1.4.1" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="Storage &amp; Migration Studio" FontSize="10.5" Foreground="#94A3B8" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SettingsButton" Content="⚙️" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="5,2" Height="24" FontSize="11" Margin="0,0,4,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SettingsButton_Click" ToolTip="環境設定 / Settings"/>
                            <Button x:Name="LanguageToggleButton" Content="🌐 EN" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="6,2" Height="24" FontSize="11" FontWeight="Bold" Foreground="#2563EB"
                                    Style="{StaticResource FluentButtonSecondary}" Click="LanguageToggleButton_Click" ToolTip="言語切り替え / Switch Language (JA / EN)"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2. RIGHT MAIN WORK AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- Tab Views Container -->
                <RowDefinition Height="Auto"/> <!-- Global Footer / Status Bar -->
            </Grid.RowDefinitions>

            <!-- TAB VIEWS CONTAINER -->
            <Grid Grid.Row="0">
            <!-- ======================================================== -->
            <!-- TAB 1: STORAGE EXPLORER (容量分析 & マルチタブ)           -->
            <!-- ======================================================== -->
            <Grid x:Name="StorageTabPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Multi-Tab Header Strip -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar & Path -->
                    <RowDefinition Height="Auto"/> <!-- Key Metrics Cards -->
                    <RowDefinition Height="*"/>    <!-- Split View (Tree & Insights) -->
                </Grid.RowDefinitions>

                <!-- Multi-Tab Strip -->
                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="16,6,16,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="StorageTabsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ScanTabModel}">
                                        <Border Margin="0,0,4,0" CornerRadius="6,6,0,0" Padding="12,6" Cursor="Hand"
                                                MouseDown="StorageTabItem_MouseDown" Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TabTitle}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                <Button Content="✕" Margin="8,0,0,0" Width="16" Height="16" FontSize="10"
                                                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                        Click="CloseStorageTabButton_Click" Tag="{Binding}" Cursor="Hand" ToolTip="タブを閉じる"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="AddStorageTabButton" Content="＋ 新しいタブ" Height="26" Margin="4,0,0,0"
                                    Style="{StaticResource FluentButtonSecondary}" Padding="8,2" FontSize="12"
                                    Click="AddStorageTabButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Storage Toolbar -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍 " Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox x:Name="PathTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource MonoFont}"
                                         Foreground="#0F172A" KeyDown="PathTextBox_KeyDown"/>
                            </Grid>
                        </Border>

                        <Button x:Name="StorageBrowseButton" Grid.Column="1" Content="参照..." Margin="8,0,0,0" Height="32"
                                Style="{StaticResource FluentButtonSecondary}" Click="BrowseButton_Click"/>

                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Width="160" Margin="10,0,10,0" Padding="8,0">
                            <TextBox x:Name="FilterTextBox" BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" FontSize="12.5" Foreground="#0F172A"
                                     TextChanged="FilterTextBox_TextChanged"/>
                        </Border>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button x:Name="ScanButton" Content="スキャン開始" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="ScanButton_Click"/>
                            <Button x:Name="CancelButton" Content="中止" Height="32" Margin="0,0,8,0" Background="#E11D48"
                                    Style="{StaticResource FluentButtonPrimary}" Visibility="Collapsed" Click="CancelButton_Click"/>
                            <Button x:Name="ExportButton" Content="Excel / CSV 出力" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="ExportButton_Click"/>
                            <Button x:Name="TabHistoryButton" Content="📈 容量推移グラフ" Height="32"
                                    Style="{StaticResource FluentButtonSecondary}" Click="HistoryButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metrics Cards -->
                <Border Grid.Row="2" Background="{StaticResource CanvasBackground}" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="スキャン対象容量" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                    <Border x:Name="MftBoostBadge" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="⚡ MFT Boost" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="ScannedSizeTextBlock" Text="0.00 GB" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TotalFilesTextBlock" Text="0 ファイル / 0 フォルダ" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="最大ファイル (Top 1)" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="LargestFileSizeTextBlock" Text="--" FontSize="22" FontWeight="Bold" Foreground="#E11D48" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LargestFileNameTextBlock" Text="--" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="前回スキャンとの差分推移" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TrendDiffTextBlock" Text="比較データなし" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentSky}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LastScanDateTextBlock" Text="初回スキャン" FontSize="11.5" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Storage Split View (Tree & Insights) -->
                <Grid Grid.Row="3" Margin="20,0,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: TreeGrid Card -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <DataGrid x:Name="FileTreeDataGrid"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="36"
                                  SelectionMode="Single"
                                  SelectionChanged="FileTreeDataGrid_SelectionChanged"
                                  MouseDoubleClick="FileTreeDataGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📂 エクスプローラーで開く" Click="CtxOpenExplorer_Click"/>
                                    <MenuItem Header="📋 パスをコピー" Click="CtxCopyPath_Click"/>
                                    <MenuItem Header="🔍 このフォルダーをルートにしてスキャン" Click="CtxScanSubtree_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🛡️ このフォルダーのNTFS権限を確認・編集" Click="CtxEditAcl_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="名前" Width="3.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:FileItemNode}">
                                            <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                                <Button Width="16" Height="16" Margin="0,0,4,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Click="ExpandCollapseButton_Click" Tag="{Binding}"
                                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ExpandIcon}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                                </Button>
                                                <TextBlock Text="{Binding IconGlyph}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="{Binding FontWeight}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="容量" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:FileItemNode}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding FormattedSize}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                <Border Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}" Background="{Binding DiffBadgeBackground}" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DiffFormatted}" FontSize="10" FontWeight="Bold" Foreground="{Binding DiffBadgeForeground}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="全体占有率" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:FileItemNode}">
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="45"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding SharePercentage}"
                                                             Foreground="{Binding SharePercentage, Converter={StaticResource PercentageToBarBrush}}"
                                                             Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"
                                                             Visibility="{Binding IsDriveRoot, Converter={StaticResource InverseBoolToVis}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ShareFormatted}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ファイル数" Binding="{Binding FileCount, StringFormat='{}{0:N0}'}" Width="80" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="最終更新" Binding="{Binding LastModified, StringFormat='yyyy/MM/dd HH:mm'}" Width="120" ElementStyle="{StaticResource LeftAlignedCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- Right: Insights & Extensions -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top 10 Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock Text="💡 容量上位ファイル (Top 10)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock x:Name="InsightsTargetScopeTextBlock" Text="スコープ: 全体" FontSize="11" Foreground="#0284C7" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>

                            <!-- Top 10 Largest Files DataGrid -->
                            <DataGrid x:Name="TopFilesDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" Background="Transparent" RowHeight="28" GridLinesVisibility="None" SelectionMode="Single" Margin="0,0,0,10"
                                      MouseDoubleClick="TopFilesDataGrid_MouseDoubleClick" ToolTip="ダブルクリックでエクスプローラーを開く">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📂 エクスプローラーで表示" Click="CtxTopFileOpenExplorer_Click"/>
                                        <MenuItem Header="📋 パスをコピー" Click="CtxTopFileCopyPath_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ファイル名" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                    <DataGridTextColumn Header="サイズ" Binding="{Binding FormattedSize}" Width="75" ElementStyle="{StaticResource RightAlignedCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Folder Direct Children Shares Header -->
                            <Grid Grid.Row="2" Margin="0,6,0,6">
                                <TextBlock Text="📁 選択フォルダの内訳 (直下シェア)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="Wクリックでツリー連動 ➔" FontSize="11" Foreground="#0284C7" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Folder Direct Children Shares DataGrid -->
                            <DataGrid x:Name="FolderChildSharesDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" Background="Transparent" RowHeight="28" GridLinesVisibility="None" SelectionMode="Single"
                                      MouseDoubleClick="FolderChildSharesDataGrid_MouseDoubleClick" ToolTip="ダブルクリックで該当フォルダへドリルダウン">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="項目名" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FolderChildShareItem}">
                                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="容量" Binding="{Binding FormattedSize}" Width="75" ElementStyle="{StaticResource RightAlignedCell}"/>
                                    <DataGridTemplateColumn Header="直下シェア" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FolderChildShareItem}">
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding RelativeSharePercentage}"
                                                                 Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding RelativeShareFormatted}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 2: LIVE ACL CONTROL (実環境 権限マネージャー)         -->
            <!-- ======================================================== -->
            <Grid x:Name="LiveAclTabPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Mode Selector Bar -->
                    <RowDefinition Height="*"/>    <!-- Active Mode View Container -->
                </Grid.RowDefinitions>

                <!-- Top Mode Selector Bar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ 権限コントロール" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <!-- Segment Switch -->
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LiveAclModeFolderRadio" Content="📁 フォルダ別 権限エディタ" IsChecked="True"
                                                 Style="{StaticResource SegmentRadioButton}" Checked="LiveAclMode_Checked"/>
                                    <RadioButton x:Name="LiveAclModeReverseRadio" Content="🔍 ユーザー/グループ 逆引き監査 (Effective Access)"
                                                 Style="{StaticResource SegmentRadioButton}" Checked="LiveAclMode_Checked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Container: Row 1 -->
                <Grid Grid.Row="1">
                    <!-- VIEW 1: フォルダ別 権限エディタ (LiveAclFolderView) -->
                    <Grid x:Name="LiveAclFolderView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Action Toolbar & Path -->
                            <RowDefinition Height="*"/>    <!-- 2-Pane Split View -->
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Label -->
                            <ColumnDefinition Width="*"/>    <!-- Path Input -->
                            <ColumnDefinition Width="Auto"/> <!-- Browse & Refresh -->
                            <ColumnDefinition Width="Auto"/> <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="🛡️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="対象フォルダ:" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" Padding="10,0" Margin="0,0,10,0">
                            <TextBox x:Name="LiveAclPathTextBox" BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                     KeyDown="LiveAclPathTextBox_KeyDown"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                            <Button x:Name="LiveAclBrowseButton" Content="参照..." Height="32" Margin="0,0,6,0" Style="{StaticResource FluentButtonSecondary}" Click="LiveAclBrowseButton_Click"/>
                            <Button x:Name="LiveAclReloadButton" Content="🔄 権限読込" Height="32" Style="{StaticResource FluentButtonSecondary}" Click="LiveAclReloadButton_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button x:Name="LiveAclApplyButton" Content="⚡ 実環境へ即時適用" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="LiveAclApplyButton_Click"/>
                            <Button x:Name="LiveAclRollbackButton" Content="↩️ バックアップ復元" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="LiveAclRollbackButton_Click" ToolTip="直前のSDDLスナップショットからロールバック"/>
                            <Button x:Name="LiveAclExportMatrixButton" Content="📋 台帳CSV出力" Height="32"
                                    Style="{StaticResource FluentButtonSecondary}" Click="LiveAclExportMatrixButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2-Pane View -->
                <Grid Grid.Row="1" Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Current ACL Cards & Drop Zone -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Folder Info & Inherit Header -->
                                <RowDefinition Height="Auto"/> <!-- Drop Zone / Help Banner -->
                                <RowDefinition Height="*"/>    <!-- Cards Area -->
                            </Grid.RowDefinitions>

                            <!-- Folder Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁 設定中のフォルダ: " FontWeight="SemiBold" FontSize="13" Foreground="#475569"/>
                                    <TextBlock x:Name="LiveAclFolderNameText" Text="(未読込)" FontWeight="Bold" FontSize="13" Foreground="#0284C7"/>
                                    <TextBlock x:Name="LiveAclOwnerText" Text="" FontSize="11" Foreground="#64748B" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <CheckBox x:Name="LiveAclInheritCheckBox" Content="親フォルダからの権限継承を含める"
                                              FontSize="11" FontWeight="Medium" Foreground="#334155" VerticalAlignment="Center"
                                              Checked="LiveAclInheritCheckBox_Changed" Unchecked="LiveAclInheritCheckBox_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- Drop Zone Banner (カード追加の受け皿) -->
                            <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                                    AllowDrop="True" Drop="LiveAclDropZone_Drop" DragOver="SimGenericDragOver">
                                <TextBlock Text="📥 右のADプリンシパル（ユーザー・グループ）をここにドロップして権限を追加"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- ACL Cards Area -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                          AllowDrop="True" Drop="LiveAclCardsContainer_Drop" DragOver="SimGenericDragOver">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="◐ 付与されているNTFSアクセス権 (カードWクリックでWindows詳細設定を編集)" FontWeight="SemiBold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="LiveAclOpenSecModalButton" Content="⚙️ 詳細権限を直接編集" FontSize="10" Height="24" Padding="10,2"
                                                Style="{StaticResource FluentButtonSecondary}" HorizontalAlignment="Right" Click="LiveAclOpenSecModalButton_Click"/>
                                    </Grid>

                                    <ItemsControl x:Name="LiveAclCardsItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SimAclEntry}">
                                                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                                                        Padding="12,8" Margin="0,0,8,8" Cursor="Hand"
                                                        MouseDown="LiveAclCard_MouseDown"
                                                        PreviewMouseMove="LiveAclCard_PreviewMouseMove">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.03"/>
                                                    </Border.Effect>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="10,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FormattedRights}" FontSize="10" FontWeight="Medium" Foreground="#2563EB"/>
                                                        </Border>
                                                        <Button Content="✕" FontSize="10" Width="18" Height="18" Margin="4,0,0,0"
                                                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                                Click="LiveAclDeleteEntryButton_Click" Tag="{Binding}" ToolTip="権限解除"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- Right: AD Principals Browser -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="👥 Active Directory / ローカルアカウント" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="32" Padding="8,0" Margin="0,0,0,10">
                                <TextBox x:Name="LiveAclPrincipalSearchTextBox" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="11" TextChanged="LiveAclPrincipalSearchTextBox_TextChanged"/>
                            </Border>

                            <ListBox x:Name="LiveAclPrincipalsListBox" Grid.Row="2" BorderThickness="0" Background="Transparent"
                                     PreviewMouseMove="LiveAclPrincipalsListBox_PreviewMouseMove">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:AdPrincipalItem}">
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="ドラッグ付与 ➔" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Notice when not domain-joined or no AD accounts -->
                            <Border x:Name="LiveAclEmptyNoticeBorder" Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="6" Padding="16" Margin="0,4" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚠️ ローカルPC環境" FontWeight="Bold" FontSize="12" Foreground="#D97706" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="※ローカルPC環境のためADプリンシパルは未接続です&#x0a;（上部の入力欄から直接アカウント名を入力して追加可能）"
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 2: ユーザー/グループ 逆引き監査 (LiveAclReverseView) -->
            <Grid x:Name="LiveAclReverseView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Control Toolbar -->
                    <RowDefinition Height="*"/>    <!-- 2-Pane: Left(Groups), Right(Folders) -->
                </Grid.RowDefinitions>

                <!-- Reverse Lookup Toolbar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- User label -->
                                <ColumnDefinition Width="180"/>  <!-- Target Account input -->
                                <ColumnDefinition Width="Auto"/> <!-- Root folder label -->
                                <ColumnDefinition Width="*"/>    <!-- Root folder path -->
                                <ColumnDefinition Width="Auto"/> <!-- Browse -->
                                <ColumnDefinition Width="Auto"/> <!-- Depth Label -->
                                <ColumnDefinition Width="120"/>  <!-- Depth ComboBox -->
                                <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="👤 調査対象:" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="32" Padding="8,0" Margin="0,0,14,0">
                                <TextBox x:Name="RevUserAccountTextBox" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="11" Text="sato.hanako"/>
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="📁 走査ルート:" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="32" Padding="8,0" Margin="0,0,8,0">
                                <TextBox x:Name="RevRootPathTextBox" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                         TextChanged="RevRootPathTextBox_TextChanged"/>
                            </Border>

                            <Button x:Name="RevBrowseRootButton" Grid.Column="4" Content="参照..." Height="32" Margin="0,0,12,0" Style="{StaticResource FluentButtonSecondary}" Click="RevBrowseRoot_Click"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="階層:" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ComboBox x:Name="RevDepthComboBox" Grid.Column="6" Height="32" Margin="0,0,14,0" FontSize="11" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="無制限 (推奨)" Tag="unlimited"/>
                                <ComboBoxItem Content="3階層" Tag="3"/>
                                <ComboBoxItem Content="5階層" Tag="5"/>
                                <ComboBoxItem Content="8階層" Tag="8"/>
                                <ComboBoxItem Content="10階層" Tag="10"/>
                            </ComboBox>

                            <StackPanel Grid.Column="7" Orientation="Horizontal">
                                <Button x:Name="RevStartScanButton" Content="🔍 逆引き調査開始" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonPrimary}" Click="RevStartScan_Click"/>
                                <Button x:Name="RevCancelScanButton" Content="⏹️ 中止" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="RevCancelScan_Click" Visibility="Collapsed"/>
                                <Button x:Name="RevExportExcelButton" Content="📋 監査台帳 Excel" Height="32"
                                        Style="{StaticResource FluentButtonSecondary}" Click="RevExportExcel_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- UNC Share Permissions Notice Banner -->
                        <Border x:Name="RevUncNoticeBanner" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                CornerRadius="6" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="UNC共有フォルダ経由でのアクセスです。本ツールは「NTFS実効権限」を評価します。実際のファイルアクセスにはファイルサーバーの「SMB共有アクセス権（Share Permissions）」の上限も併せて適用されます。"
                                           FontSize="10" Foreground="#92400E" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Main 2-Pane: Left(Groups & Info), Right(Folders Grid) -->
                <Grid Grid.Row="1" Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.2*"/> <!-- Group Memberships & Trace -->
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="6.8*"/> <!-- Accessible Folders Table -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Profile & Group Memberships -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Account Header -->
                                <RowDefinition Height="Auto"/> <!-- Section Title -->
                                <RowDefinition Height="*"/>    <!-- Groups List -->
                                <RowDefinition Height="Auto"/> <!-- Help / Nesting Legend -->
                            </Grid.RowDefinitions>

                            <!-- Account Info Banner -->
                            <Border Grid.Row="0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="RevTargetAccountHeader" Text="👤 調査対象: (未選択)" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                    <TextBlock x:Name="RevTargetAccountSub" Text="所属グループと実効権限を自動解決します" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="👥 所属グループ (多重入れ子・再帰解決)" FontWeight="Bold" FontSize="11" Foreground="#1E293B"/>
                                <TextBlock x:Name="RevGroupCountText" Text="0 件" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Groups ListBox -->
                            <ListBox x:Name="RevGroupsListBox" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type eff:PrincipalGroupMembership}">
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Sid}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="#94A3B8"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{Binding DirectBadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DirectStatusText}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Legend Footer -->
                            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                <TextBlock Text="💡 青バッジ＝直接所属 / 紫バッジ＝多重入れ子所属 (AD Chainにより自動解決)" FontSize="10" Foreground="#64748B" LineHeight="14" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right: Accessible Folders & Stats -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- KPI Cards Row -->
                                <RowDefinition Height="Auto"/> <!-- Section Title / Filter -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                                <RowDefinition Height="Auto"/> <!-- Status / Progress -->
                            </Grid.RowDefinitions>

                            <!-- KPI Cards -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="アクセス可能" FontSize="10" Foreground="#1E40AF"/>
                                        <TextBlock x:Name="RevKpiTotal" Text="0 箇所" FontSize="14" FontWeight="Bold" Foreground="#1D4ED8"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="フルコントロール" FontSize="10" Foreground="#991B1B"/>
                                        <TextBlock x:Name="RevKpiFull" Text="0 箇所" FontSize="14" FontWeight="Bold" Foreground="#DC2626"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="変更 (Modify)" FontSize="10" Foreground="#92400E"/>
                                        <TextBlock x:Name="RevKpiMod" Text="0 箇所" FontSize="14" FontWeight="Bold" Foreground="#D97706"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="6" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="読み取り専用" FontSize="10" Foreground="#065F46"/>
                                        <TextBlock x:Name="RevKpiRead" Text="0 箇所" FontSize="14" FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Table Header with Quick Filter -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="📂 アクセス可能フォルダー一覧 (Wクリックでエクスプローラー直行)" FontWeight="Bold" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="絞り込み:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="26" Width="180" Padding="6,0">
                                        <TextBox x:Name="RevFolderFilterTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="10" TextChanged="RevFolderFilterTextBox_TextChanged"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- DataGrid -->
                            <DataGrid x:Name="RevFoldersDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" GridLinesVisibility="None" RowHeight="28"
                                      HeadersVisibility="Column"
                                      MouseDoubleClick="RevFoldersDataGrid_MouseDoubleClick" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="フォルダー名" Binding="{Binding FolderName}" Width="160" FontWeight="Bold"/>
                                    <DataGridTemplateColumn Header="実効アクセス権" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding RightsBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedRights}" FontSize="10" FontWeight="Bold" Foreground="{Binding RightsBadgeForeground}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="付与形態 / 経由グループ" Binding="{Binding GrantSource}" Width="200"/>
                                    <DataGridTextColumn Header="完全パス" Binding="{Binding FolderPath}" Width="*" FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Progress & Status -->
                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <TextBlock x:Name="RevStatusText" Text="準備完了" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="RevProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center" Margin="100,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

            <!-- ======================================================== -->
            <!-- TAB 3: MIGRATION SIMULATION STUDIO (FolderMorph Studio)   -->
            <!-- ======================================================== -->
            <Grid x:Name="SimulationTabPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Studio Action Toolbar -->
                    <RowDefinition Height="*"/>    <!-- 3-Pane Split View -->
                </Grid.RowDefinitions>

                <!-- Studio Action Toolbar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Project Info -->
                            <ColumnDefinition Width="*"/>    <!-- Target Path Settings -->
                            <ColumnDefinition Width="Auto"/> <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <!-- Project info -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="🚀" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="SimProjectNameTextBox" Text="新ファイルサーバー移行設計_Ver1" FontWeight="Bold" FontSize="12"
                                     Foreground="#0F172A" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Target folder setting for skeleton -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" MinWidth="260" Padding="10,0" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📁 移行先ルート: " Foreground="#64748B" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="SimTargetRootTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}" Text="\\NewServer01\Share"/>
                                <Button x:Name="SimTargetBrowseButton" Grid.Column="2" Content="参照..." Background="Transparent" BorderThickness="0" Foreground="#0284C7" FontSize="11" Click="SimTargetBrowse_Click"/>
                            </Grid>
                        </Border>

                        <!-- Toolbar Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SimSaveProjectButton" Content="💾 保存" Height="32" Margin="0,0,5,0" Padding="8,4" FontSize="11"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimSaveProjectButton_Click" ToolTip="プロジェクト保存 (.fmorph)"/>
                            <Button x:Name="SimLoadProjectButton" Content="📂 読込" Height="32" Margin="0,0,5,0" Padding="8,4" FontSize="11"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimLoadProjectButton_Click" ToolTip="プロジェクト読込"/>
                            <Button x:Name="SimDiffReviewButton" Content="⚖️ 差分 (Diff)" Height="32" Margin="0,0,5,0" Padding="10,4" FontSize="11"
                                    Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimDiffReviewButton_Click" ToolTip="変化点差分インスペクター"/>
                            <Button x:Name="SimDeploySkeletonButton" Content="🚀 ガワ先行作成" Height="32" Margin="0,0,5,0" Padding="10,4" FontSize="11"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimDeploySkeletonButton_Click" ToolTip="空フォルダとNTFS権限を新環境へ一括作成"/>
                            <Button x:Name="SimExportScriptsButton" Content="⚙️ 移行スクリプト" Height="32" Margin="0,0,5,0" Padding="8,4" FontSize="11"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimExportScriptsButton_Click" ToolTip="Robocopy / FastCopy スクリプト生成"/>
                            <Button x:Name="SimExportExcelButton" Content="📊 Excel設計書" Height="32" Padding="8,4" FontSize="11"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimExportExcelButton_Click" ToolTip="移行設計書Excel出力"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3-Pane Split View -->
                <Grid Grid.Row="1" Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.8*"/> <!-- Pane 1: Source Explorer -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="4.6*"/> <!-- Pane 2: Mock Tree & Interactive Panel -->
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2.6*"/> <!-- Pane 3: AD Palette -->
                    </Grid.ColumnDefinitions>

                    <!-- ============================================== -->
                    <!-- PANE 1: SOURCE SERVER EXPLORER                 -->
                    <!-- ============================================== -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="現行ファイルサーバー (移行元)" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock Text="サブフォルダを掴んで中央のモックツリーへ直接ドロップ" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Path & Load -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Height="28" Padding="6,0">
                                    <TextBox x:Name="SimSourcePathTextBox" BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                                <Button x:Name="SimSourceLoadButton" Grid.Column="1" Content="読込" Height="28" Margin="6,0,0,0"
                                        Style="{StaticResource FluentButtonSecondary}" Padding="10,2" Click="SimSourceLoadButton_Click"/>
                            </Grid>

                            <!-- Source TreeView (Draggable) -->
                            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Background="#F8FAFC">
                                <TreeView x:Name="SimSourceTreeView" BorderThickness="0" Background="Transparent"
                                          SelectedItemChanged="SimSourceTreeView_SelectedItemChanged"
                                          PreviewMouseMove="SimSourceTreeView_PreviewMouseMove">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="📁 " FontSize="11"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="10"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>

                            <!-- Clone Button -->
                            <Button Grid.Row="3" x:Name="SimCloneSelectedButton" Content="➡️ 選択フォルダを中央へ新設配置" Height="32" Margin="0,8,0,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimCloneSelectedButton_Click"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- ============================================== -->
                    <!-- PANE 2: MOCK TREE & INTERACTIVE FOLDER PANEL   -->
                    <!-- ============================================== -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Mock Header -->
                                <RowDefinition Height="1.2*"/> <!-- Mock TreeView (Draggable, Indented) -->
                                <RowDefinition Height="Auto"/> <!-- Divider -->
                                <RowDefinition Height="1.1*"/> <!-- Selected Folder Accordion Panel -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="新環境 仮想フォルダツリー設計" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                    <TextBlock Text="💡 閉じたフォルダ行に直ドロップでサブ化 / クイックボタンや左ずらしで一気にルートへ昇格" FontSize="10" Foreground="#0284C7"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="SimAddRootFolderButton" Content="＋ ルートフォルダ新設" Height="26" Style="{StaticResource FluentButtonSecondary}"
                                            FontSize="11" Padding="8,2" Click="SimAddRootFolderButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Mock TreeView with Drop & ContextMenu -->
                            <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#FFFFFF">
                                <TreeView x:Name="SimMockTreeView" BorderThickness="0" Background="Transparent"
                                          SelectedItemChanged="SimMockTreeView_SelectedItemChanged"
                                          AllowDrop="True"
                                          Drop="SimMockTreeView_Drop"
                                          DragOver="SimMockTreeView_DragOver"
                                          PreviewMouseMove="SimMockTreeView_PreviewMouseMove">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📁 新規サブフォルダ作成" Click="CtxSimAddChild_Click"/>
                                            <MenuItem Header="✏️ フォルダ名の変更" Click="CtxSimRename_Click"/>
                                            <Separator/>
                                            <MenuItem Header="⏮ 第1階層（ルート）へ昇格" Click="CtxSimJumpRoot_Click"/>
                                            <MenuItem Header="◀ 1階層昇格" Click="CtxSimPromote_Click"/>
                                            <MenuItem Header="▶ 1階層降格 (サブ化)" Click="CtxSimDemote_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🗑️ 削除" Click="CtxSimDelete_Click"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Border CornerRadius="4" Padding="6,3" Margin="0,1" Background="Transparent">
                                                <Grid Margin="{Binding IndentMargin}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Icon & Name -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Level Pill -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Mapping Badge -->
                                                        <ColumnDefinition Width="*"/>    <!-- Quick Level Buttons -->
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📁 " FontSize="12.5" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="3" Padding="5,1"
                                                            Background="{Binding LevelPillBackground}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LevelPillText}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding LevelPillForeground}"/>
                                                    </Border>

                                                    <Border Grid.Column="2" Margin="6,0,0,0" CornerRadius="3" Padding="5,1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                                            VerticalAlignment="Center" Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding MappingBadgeText}" FontSize="10.5" Foreground="#B45309"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="⏮" Width="20" Height="20" Padding="0" FontSize="10" ToolTip="第1階層(ルート)へ一気ジャンプ"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="2,0" Click="SimQuickJumpRoot_Click" Tag="{Binding}"/>
                                                        <Button Content="◀" Width="20" Height="20" Padding="0" FontSize="10" ToolTip="1階層昇格"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="2,0" Click="SimQuickPromote_Click" Tag="{Binding}"/>
                                                        <Button Content="▶" Width="20" Height="20" Padding="0" FontSize="10" ToolTip="1階層降格"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="2,0" Click="SimQuickDemote_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>

                            <Separator Grid.Row="2" Margin="0,8,0,8" Background="#E2E8F0"/>

                            <!-- Accordion Panel for Selected Folder (広域ドロップ受容) -->
                            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12"
                                    AllowDrop="True" Drop="SimAccordion_Drop" DragOver="SimGenericDragOver">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Selected Node Info -->
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📁 選択中のフォルダ: " FontWeight="Bold" FontSize="12.5" Foreground="#334155"/>
                                                <TextBlock x:Name="SimSelectedFolderNameText" Text="(未選択 - 上のフォルダをクリック)" FontWeight="Bold" FontSize="12.5" Foreground="#0284C7"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SimInheritCheckBox" Content="親からの権限継承を含める" HorizontalAlignment="Right"
                                                      FontSize="12" Checked="SimInheritCheckBox_Changed" Unchecked="SimInheritCheckBox_Changed"/>
                                        </Grid>

                                        <!-- Drop Zone 1: Subfolder Maker -->
                                        <Border Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6" Margin="0,0,0,8" AllowDrop="True"
                                                Drop="SimSubfolderDropZone_Drop" DragOver="SimGenericDragOver">
                                            <TextBlock Text="📥 左の現行フォルダをここにドロップすると、この直下にサブフォルダ化"
                                                       FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Drop Zone 2: N:1 Source Mapping Area -->
                                        <Border Background="#FAF5FF" BorderBrush="#C084FC" BorderThickness="1"
                                                CornerRadius="4" Padding="8" Margin="0,0,0,8" AllowDrop="True"
                                                Drop="SimMappingDropZone_Drop" DragOver="SimGenericDragOver">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="🔗 現行サーバーとの紐づけ (データ移行元 / N対1統合)" FontSize="11.5" FontWeight="Bold" Foreground="#7E22CE"/>
                                                    <TextBlock Text="ここに現行フォルダをドロップして追加統合" FontSize="11" Foreground="#A855F7" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <!-- List of mapped sources -->
                                                <ItemsControl x:Name="SimMappedSourcesItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FFFFFF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2"
                                                                    Cursor="Hand" MouseDown="SimMappedSource_MouseDown" PreviewMouseMove="SimMappedSource_PreviewMouseMove">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding StringFormat='🔗 {0}'}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="#4C1D95" VerticalAlignment="Center"/>
                                                                    <Button Content="✕ 解除" HorizontalAlignment="Right" FontSize="10.5" Foreground="#E11D48"
                                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                            Click="SimRemoveMapping_Click" Tag="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Drop Zone 3: AD Permissions Cards Area -->
                                        <Border Background="#F0F9FF" BorderBrush="#38BDF8" BorderThickness="1"
                                                CornerRadius="4" Padding="8" AllowDrop="True"
                                                Drop="SimAclDropZone_Drop" DragOver="SimGenericDragOver">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="🛡️ 割り当てられたADアクセス権 (カードWクリックで詳細編集)" FontSize="11.5" FontWeight="Bold" Foreground="#0369A1"/>
                                                    <Button x:Name="SimOpenSecModalButton" Content="⚙️ セキュリティ詳細設定" FontSize="10.5" Height="22" Padding="6,1"
                                                            Style="{StaticResource FluentButtonSecondary}" HorizontalAlignment="Right"
                                                            Click="SimOpenSecModalButton_Click"/>
                                                </Grid>
                                                <!-- Permissions Cards Grid -->
                                                <ItemsControl x:Name="SimAclCardsItemsControl">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:SimAclEntry}">
                                                            <Border Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4"
                                                                    Padding="8,4" Margin="0,0,6,6" Cursor="Hand"
                                                                    MouseDown="SimAclCard_MouseDown"
                                                                    PreviewMouseMove="SimAclCard_PreviewMouseMove">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                                    <Border Background="#E0F2FE" CornerRadius="3" Padding="4,1" Margin="6,0,4,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FormattedRights}" FontSize="10.5" Foreground="#0284C7"/>
                                                                    </Border>
                                                                    <Button Content="✕" FontSize="10" Width="14" Height="14" Margin="2,0,0,0"
                                                                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                                            Click="SimDeleteAclEntryButton_Click" Tag="{Binding}" ToolTip="権限解除"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- ============================================== -->
                    <!-- PANE 3: AD PALETTE (USERS & GROUPS)            -->
                    <!-- ============================================== -->
                    <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="AD ユーザー &amp; グループ" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A"/>
                                    <Border x:Name="DomainStatusBadge" Background="#DCFCE7" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="DomainStatusText" Text="🟢 CORP.LOCAL" FontSize="10.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="カードを中央のフォルダへドラッグして権限付与" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="32" Padding="8,0" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍 " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AdSearchTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" FontSize="12" TextChanged="AdSearchTextBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AdPrincipalsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:AdPrincipalItem}">
                                                <Border Background="{Binding BadgeBackground}" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                                                        PreviewMouseMove="AdCard_PreviewMouseMove" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 3: LINK FIXER (ショートカット＆リンク一括修復)        -->
            <!-- ======================================================== -->
            <Grid x:Name="LinkFixTabPanel" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="🔗 サーバー移行に伴うショートカット (LNK) / パス参照の一括修復" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="ファイルサーバー移行後、旧パス（例: \\OldServer\Share）を指したまま切断されたショートカットを一括検出し、新パスへ安全に書き換えます。"
                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="検索対象フォルダ (デスクトップ等)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" Padding="10,0">
                                    <TextBox x:Name="LinkSearchScopeTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
