<Window x:Class="AstraSize.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AstraSize"
        xmlns:models="clr-namespace:AstraSize.Models"
        mc:Ignorable="d"
        Title="FolderMorpher - Storage Monitor &amp; Migration Studio"
        Height="920" Width="1480"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBackground}"
        FontFamily="{StaticResource MainFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Collapsible Navigation Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Main Content Work Area -->
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT COLLAPSIBLE NAVIGATION SIDEBAR -->
        <Border Grid.Column="0" x:Name="SidebarBorder" Width="210" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>   <!-- Header (Brand & Toggle) -->
                    <RowDefinition Height="*"/>    <!-- Nav List -->
                    <RowDefinition Height="Auto"/> <!-- Footer / Version -->
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <Border Grid.Row="0" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SidebarToggleButton" Content="☰" Width="34" Height="34"
                                Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#475569"
                                Cursor="Hand" Click="SidebarToggleButton_Click" ToolTip="サイドバーの開閉 (収縮 / 展開)"/>
                        <StackPanel x:Name="SidebarBrandPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="📁" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="FolderMorpher" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Nav Items -->
                <StackPanel Grid.Row="1" Margin="8,12">
                    <RadioButton x:Name="NavTabStorage" Style="{StaticResource SidebarNavButton}"
                                 IsChecked="True" Checked="NavTab_Checked" Tag="📊" Content="容量分析 &amp; 監視" ToolTip="📊 容量分析 &amp; 監視"/>
                    <RadioButton x:Name="NavTabLiveAcl" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🛡️" Content="権限コントロール" ToolTip="🛡️ 実環境 権限コントロール"/>
                    <RadioButton x:Name="NavTabSimulation" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🚀" Content="移行スタジオ" ToolTip="🚀 移行シミュレーション"/>
                    <RadioButton x:Name="NavTabLinkFix" Style="{StaticResource SidebarNavButton}"
                                 Checked="NavTab_Checked" Tag="🔗" Content="リンク一括修復" ToolTip="🔗 ショートカット修復"/>
                </StackPanel>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel x:Name="SidebarFooterPanel">
                        <TextBlock Text="FolderMorpher v2.5" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        <TextBlock Text="Enterprise Ready" FontSize="9" Foreground="#CBD5E1" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. RIGHT MAIN WORK AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- Tab Views Container -->
                <RowDefinition Height="Auto"/> <!-- Global Footer / Status Bar -->
            </Grid.RowDefinitions>

            <!-- TAB VIEWS CONTAINER -->
            <Grid Grid.Row="0">
            <!-- ======================================================== -->
            <!-- TAB 1: STORAGE EXPLORER (容量分析 & マルチタブ)           -->
            <!-- ======================================================== -->
            <Grid x:Name="StorageTabPanel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Multi-Tab Header Strip -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar & Path -->
                    <RowDefinition Height="Auto"/> <!-- Key Metrics Cards -->
                    <RowDefinition Height="*"/>    <!-- Split View (Tree & Insights) -->
                </Grid.RowDefinitions>

                <!-- Multi-Tab Strip -->
                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="16,6,16,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="StorageTabsItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ScanTabModel}">
                                        <Border Margin="0,0,4,0" CornerRadius="6,6,0,0" Padding="12,6" Cursor="Hand"
                                                MouseDown="StorageTabItem_MouseDown" Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E2E8F0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#FFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                            <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TabTitle}" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                <Button Content="✕" Margin="8,0,0,0" Width="16" Height="16" FontSize="9"
                                                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                        Click="CloseStorageTabButton_Click" Tag="{Binding}" Cursor="Hand" ToolTip="タブを閉じる"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="AddStorageTabButton" Content="＋ 新しいタブ" Height="26" Margin="4,0,0,0"
                                    Style="{StaticResource FluentButtonSecondary}" Padding="8,2" FontSize="11"
                                    Click="AddStorageTabButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Storage Toolbar -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="DriveComboBox" Grid.Column="0" Width="160" Height="32" Margin="0,0,8,0"
                                  VerticalContentAlignment="Center" FontSize="12" SelectionChanged="DriveComboBox_SelectionChanged"/>

                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍 " Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBox x:Name="PathTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                         Foreground="#0F172A" KeyDown="PathTextBox_KeyDown"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Content="参照..." Margin="8,0,0,0" Height="32"
                                Style="{StaticResource FluentButtonSecondary}" Click="BrowseButton_Click"/>

                        <Border Grid.Column="3" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Width="140" Margin="10,0,10,0" Padding="8,0">
                            <TextBox x:Name="FilterTextBox" BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" FontSize="12" Foreground="#0F172A"
                                     TextChanged="FilterTextBox_TextChanged"/>
                        </Border>

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button x:Name="ScanButton" Content="スキャン開始" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="ScanButton_Click"/>
                            <Button x:Name="CancelButton" Content="中止" Height="32" Margin="0,0,8,0" Background="#E11D48"
                                    Style="{StaticResource FluentButtonPrimary}" Visibility="Collapsed" Click="CancelButton_Click"/>
                            <Button x:Name="ExportButton" Content="Excel / CSV 出力" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="ExportButton_Click"/>
                            <Button x:Name="TabHistoryButton" Content="📈 容量推移グラフ" Height="32"
                                    Style="{StaticResource FluentButtonSecondary}" Click="HistoryButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metrics Cards -->
                <Border Grid.Row="2" Background="{StaticResource CanvasBackground}" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="スキャン対象容量" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="ScannedSizeTextBlock" Text="0.00 GB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TotalFilesTextBlock" Text="0 ファイル / 0 フォルダ" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="ドライブ / ボリューム空き容量" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="FreePercentTextBlock" Text="--%" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock x:Name="FreeSpaceTextBlock" Text="-- GB 空き" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                <ProgressBar x:Name="DriveUsageProgressBar" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentSky}" Background="#E2E8F0" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="最大ファイル (Top 1)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="LargestFileSizeTextBlock" Text="--" FontSize="20" FontWeight="Bold" Foreground="#E11D48" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LargestFileNameTextBlock" Text="--" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="前回スキャンとの差分推移" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="TrendDiffTextBlock" Text="比較データなし" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentSky}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LastScanDateTextBlock" Text="初回スキャン" FontSize="10" Foreground="{StaticResource TextSubtle}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Storage Split View (Tree & Insights) -->
                <Grid Grid.Row="3" Margin="20,0,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: TreeGrid Card -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="14">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <DataGrid x:Name="FileTreeDataGrid"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F8FAFC"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowHeight="36"
                                  SelectionMode="Single"
                                  SelectionChanged="FileTreeDataGrid_SelectionChanged"
                                  MouseDoubleClick="FileTreeDataGrid_MouseDoubleClick"
                                  PreviewMouseMove="FileTreeDataGrid_PreviewMouseMove">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📂 エクスプローラーで開く" Click="CtxOpenExplorer_Click"/>
                                    <MenuItem Header="📋 パスをコピー" Click="CtxCopyPath_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🛡️ 実環境 権限コントロールで開く" Click="CtxOpenLiveAcl_Click"/>
                                    <MenuItem Header="🚀 移行シミュレーションへ送る" Click="CtxSendToSimulation_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="名前" Width="3.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:FileItemNode}">
                                            <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                                <Button Width="16" Height="16" Padding="0" Margin="0,0,4,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                                        Click="ExpandCollapseButton_Click" Tag="{Binding}">
                                                    <TextBlock Text="{Binding IsExpanded, Converter={StaticResource ItemIconConv}}" FontSize="9" Foreground="#64748B"/>
                                                </Button>
                                                <TextBlock Text="{Binding IconGlyph}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="容量" Binding="{Binding FormattedSize}" Width="90" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTemplateColumn Header="全体占有率" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:FileItemNode}">
                                            <Grid Margin="4,2">
                                                <!-- Root: dash display -->
                                                <TextBlock Text="―" FontSize="11" Foreground="#94A3B8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding DashVisibility}"/>
                                                <!-- Non-root: Option A (mini bar on left, bold dark text on right) -->
                                                <Grid Visibility="{Binding ProgressBarVisibility}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding Percentage}"
                                                                 Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PercentageFormatted}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ファイル数" Binding="{Binding FileCount, StringFormat='{}{0:N0}'}" Width="80" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn Header="最終更新" Binding="{Binding LastModified, StringFormat='yyyy/MM/dd HH:mm'}" Width="120" ElementStyle="{StaticResource LeftAlignedCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- Right: Insights & Extensions -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.03"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top 10 Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <Grid>
                                    <TextBlock Text="💡 容量上位ファイル (Top 10)" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                    <TextBlock x:Name="InsightsTargetScopeTextBlock" Text="スコープ: 全体" FontSize="10" Foreground="#0284C7" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>

                            <!-- Top 10 Largest Files DataGrid -->
                            <DataGrid x:Name="TopFilesDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" Background="Transparent" RowHeight="24" SelectionMode="Single" Margin="0,0,0,10"
                                      MouseDoubleClick="TopFilesDataGrid_MouseDoubleClick" ToolTip="ダブルクリックでエクスプローラーを開く">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📂 エクスプローラーで表示" Click="CtxTopFileOpenExplorer_Click"/>
                                        <MenuItem Header="📋 パスをコピー" Click="CtxTopFileCopyPath_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ファイル名" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                    <DataGridTextColumn Header="サイズ" Binding="{Binding FormattedSize}" Width="75" ElementStyle="{StaticResource RightAlignedCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Folder Direct Children Shares Header -->
                            <Grid Grid.Row="2" Margin="0,6,0,6">
                                <TextBlock Text="📁 選択フォルダの内訳 (直下シェア)" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                                <TextBlock Text="Wクリックでツリー連動 ➔" FontSize="10" Foreground="#0284C7" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Folder Direct Children Shares DataGrid -->
                            <DataGrid x:Name="FolderChildSharesDataGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                                      BorderThickness="0" Background="Transparent" RowHeight="26" SelectionMode="Single"
                                      MouseDoubleClick="FolderChildSharesDataGrid_MouseDoubleClick" ToolTip="ダブルクリックで該当フォルダへドリルダウン">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="項目名" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FolderChildShareItem}">
                                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="容量" Binding="{Binding FormattedSize}" Width="75" ElementStyle="{StaticResource RightAlignedCell}"/>
                                    <DataGridTemplateColumn Header="直下シェア" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:FolderChildShareItem}">
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="45"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding RelativeSharePercentage}"
                                                                 Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding RelativeShareFormatted}"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 2: LIVE ACL CONTROL (実環境 権限マネージャー)         -->
            <!-- ======================================================== -->
            <Grid x:Name="LiveAclTabPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Action Toolbar & Path -->
                    <RowDefinition Height="*"/>    <!-- 2-Pane Split View -->
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Label -->
                            <ColumnDefinition Width="*"/>    <!-- Path Input -->
                            <ColumnDefinition Width="Auto"/> <!-- Browse & Refresh -->
                            <ColumnDefinition Width="Auto"/> <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="🛡️ " FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="対象フォルダ:" FontWeight="Bold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                            <TextBox x:Name="LiveAclPathTextBox" BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                     KeyDown="LiveAclPathTextBox_KeyDown"/>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                            <Button Content="参照..." Height="30" Margin="0,0,6,0" Style="{StaticResource FluentButtonSecondary}" Click="LiveAclBrowseButton_Click"/>
                            <Button Content="🔄 権限読込" Height="30" Style="{StaticResource FluentButtonSecondary}" Click="LiveAclReloadButton_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button x:Name="LiveAclApplyButton" Content="⚡ 実環境へ即時適用" Height="30" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="LiveAclApplyButton_Click"/>
                            <Button x:Name="LiveAclRollbackButton" Content="↩️ バックアップ復元" Height="30" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="LiveAclRollbackButton_Click" ToolTip="直前のSDDLスナップショットからロールバック"/>
                            <Button x:Name="LiveAclExportMatrixButton" Content="📋 台帳CSV出力" Height="30"
                                    Style="{StaticResource FluentButtonSecondary}" Click="LiveAclExportMatrixButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2-Pane View -->
                <Grid Grid.Row="1" Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6.5*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="3.5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Current ACL Cards & Drop Zone -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Folder Info & Inherit Header -->
                                <RowDefinition Height="Auto"/> <!-- Drop Zone / Help Banner -->
                                <RowDefinition Height="*"/>    <!-- Cards Area -->
                                <RowDefinition Height="Auto"/> <!-- Trash Zone -->
                            </Grid.RowDefinitions>

                            <!-- Folder Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁 設定中のフォルダ: " FontWeight="Bold" FontSize="13" Foreground="#334155"/>
                                    <TextBlock x:Name="LiveAclFolderNameText" Text="(未読込)" FontWeight="Bold" FontSize="13" Foreground="#0284C7"/>
                                    <TextBlock x:Name="LiveAclOwnerText" Text="" FontSize="11" Foreground="#64748B" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="LiveAclInheritCheckBox" Content="親フォルダからの権限継承を含める" HorizontalAlignment="Right"
                                          FontSize="11" VerticalAlignment="Center" Checked="LiveAclInheritCheckBox_Changed" Unchecked="LiveAclInheritCheckBox_Changed"/>
                            </Grid>

                            <!-- Live AD Drop Target Zone -->
                            <Border Grid.Row="1" Background="#F0F9FF" BorderBrush="#38BDF8" BorderThickness="1"
                                    CornerRadius="6" Padding="12,8" Margin="0,0,0,12" AllowDrop="True"
                                    Drop="LiveAclDropZone_Drop" DragOver="SimGenericDragOver">
                                <Grid>
                                    <TextBlock Text="📥 右のADプリンシパル（ユーザー・グループ）をここにドロップして権限を追加"
                                               FontSize="11" Foreground="#0284C7" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Permissions Cards Flow -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="🛡️ 付与されているNTFSアクセス権 (カードWクリックでWindows詳細設定を編集)"
                                                   FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                        <Button Content="⚙️ 詳細権限を直接編集" FontSize="10" Height="22" Padding="8,1"
                                                Style="{StaticResource FluentButtonSecondary}" HorizontalAlignment="Right"
                                                Click="LiveAclOpenSecModalButton_Click"/>
                                    </Grid>

                                    <ItemsControl x:Name="LiveAclCardsItemsControl">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:SimAclEntry}">
                                                <Border Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6"
                                                        Padding="10,6" Margin="0,0,8,8" Cursor="Hand" MouseDown="LiveAclCard_MouseDown">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                        <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" Margin="8,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FormattedRights}" FontSize="10" Foreground="#0284C7"/>
                                                        </Border>
                                                        <Button Content="✕" FontSize="10" Width="16" Height="16" Margin="2,0,0,0"
                                                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                                Click="LiveAclDeleteEntryButton_Click" Tag="{Binding}" ToolTip="権限削除"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Trash Drop Zone -->
                            <Border Grid.Row="3" Background="#FFF1F2" BorderBrush="#F43F5E" BorderThickness="1"
                                    CornerRadius="6" Height="36" Margin="0,8,0,0" AllowDrop="True"
                                    Drop="LiveAclTrashZone_Drop" DragOver="SimGenericDragOver">
                                <TextBlock Text="🗑️ ここにドロップして権限カードをポイ捨て削除" FontSize="11" FontWeight="Bold"
                                           Foreground="#E11D48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- Right: AD Principals Browser -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="👥 Active Directory / ローカルアカウント" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,10">
                                <TextBox x:Name="LiveAclPrincipalSearchTextBox" BorderThickness="0" Background="Transparent"
                                         FontSize="11" TextChanged="LiveAclPrincipalSearchTextBox_TextChanged"/>
                            </Border>

                            <ListBox x:Name="LiveAclPrincipalsListBox" Grid.Row="2" BorderThickness="0" Background="Transparent"
                                     PreviewMouseMove="LiveAclPrincipalsListBox_PreviewMouseMove">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:AdPrincipalItem}">
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,2" Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="ドラッグ付与 ➔" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Notice when not domain-joined or no AD accounts -->
                            <Border x:Name="LiveAclEmptyNoticeBorder" Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="6" Padding="16" Margin="0,4" VerticalAlignment="Center" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚠️ ローカルPC環境" FontWeight="Bold" FontSize="12" Foreground="#D97706" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="※ローカルPC環境のためADプリンシパルは未接続です&#x0a;（上部の入力欄から直接アカウント名を入力して追加可能）"
                                               FontSize="11" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 3: MIGRATION SIMULATION STUDIO (FolderMorph Studio)   -->
            <!-- ======================================================== -->
            <Grid x:Name="SimulationTabPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Studio Action Toolbar -->
                    <RowDefinition Height="*"/>    <!-- 3-Pane Split View -->
                </Grid.RowDefinitions>

                <!-- Studio Action Toolbar -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Project Info -->
                            <ColumnDefinition Width="*"/>    <!-- Target Path Settings -->
                            <ColumnDefinition Width="Auto"/> <!-- Actions -->
                        </Grid.ColumnDefinitions>

                        <!-- Project info -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="🚀 " FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="SimProjectNameTextBox" Text="新ファイルサーバー移行設計_Ver1" FontWeight="Bold" FontSize="13"
                                     Foreground="#0F172A" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Target folder setting for skeleton -->
                        <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0" Margin="0,0,12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📁 移行先ルート (新NAS/UNC): " Foreground="#64748B" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="SimTargetRootTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}" Text="\\NewServer01\Share"/>
                                <Button Grid.Column="2" Content="参照..." Background="Transparent" BorderThickness="0" Foreground="#0284C7" FontSize="11" Click="SimTargetBrowse_Click"/>
                            </Grid>
                        </Border>

                        <!-- Toolbar Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SimSaveProjectButton" Content="💾 保存 (.fmorph)" Height="32" Margin="0,0,6,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimSaveProjectButton_Click"/>
                            <Button x:Name="SimLoadProjectButton" Content="📂 読込" Height="32" Margin="0,0,6,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimLoadProjectButton_Click"/>
                            <Button x:Name="SimDiffReviewButton" Content="⚖️ 変化点差分 (Diff)" Height="32" Margin="0,0,6,0"
                                    Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimDiffReviewButton_Click"/>
                            <Button x:Name="SimDeploySkeletonButton" Content="🚀 ガワ先行作成" Height="32" Margin="0,0,6,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimDeploySkeletonButton_Click"/>
                            <Button x:Name="SimExportScriptsButton" Content="⚙️ 移行スクリプト生成" Height="32" Margin="0,0,6,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimExportScriptsButton_Click"/>
                            <Button x:Name="SimExportExcelButton" Content="📊 Excel設計書" Height="32"
                                    Style="{StaticResource FluentButtonSecondary}" Click="SimExportExcelButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3-Pane Split View -->
                <Grid Grid.Row="1" Margin="20,12,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.8*"/> <!-- Pane 1: Source Explorer -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="4.6*"/> <!-- Pane 2: Mock Tree & Interactive Panel -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2.6*"/> <!-- Pane 3: AD Palette -->
                    </Grid.ColumnDefinitions>

                    <!-- ============================================== -->
                    <!-- PANE 1: SOURCE SERVER EXPLORER                 -->
                    <!-- ============================================== -->
                    <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="現行ファイルサーバー (移行元)" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                <TextBlock Text="サブフォルダを掴んで中央のモックツリーへ直接ドロップ" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Path & Load -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Height="28" Padding="6,0">
                                    <TextBox x:Name="SimSourcePathTextBox" BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                                <Button Grid.Column="1" Content="読込" Height="28" Margin="6,0,0,0"
                                        Style="{StaticResource FluentButtonSecondary}" Padding="10,2" Click="SimSourceLoadButton_Click"/>
                            </Grid>

                            <!-- Source TreeView (Draggable) -->
                            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4" Background="#F8FAFC">
                                <TreeView x:Name="SimSourceTreeView" BorderThickness="0" Background="Transparent"
                                          SelectedItemChanged="SimSourceTreeView_SelectedItemChanged"
                                          PreviewMouseMove="SimSourceTreeView_PreviewMouseMove">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="📁 " FontSize="11"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="10"/>
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>

                            <!-- Clone Button -->
                            <Button Grid.Row="3" x:Name="SimCloneSelectedButton" Content="➡️ 選択フォルダを中央へ新設配置" Height="32" Margin="0,8,0,0"
                                    Style="{StaticResource FluentButtonPrimary}" Click="SimCloneSelectedButton_Click"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- ============================================== -->
                    <!-- PANE 2: MOCK TREE & INTERACTIVE FOLDER PANEL   -->
                    <!-- ============================================== -->
                    <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Mock Header -->
                                <RowDefinition Height="1.2*"/> <!-- Mock TreeView (Draggable, Indented) -->
                                <RowDefinition Height="Auto"/> <!-- Divider -->
                                <RowDefinition Height="1.1*"/> <!-- Selected Folder Accordion Panel -->
                                <RowDefinition Height="Auto"/> <!-- Trash Zone -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="新環境 仮想フォルダツリー設計" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="💡 閉じたフォルダ行に直ドロップでサブ化 / クイックボタンや左ずらしで一気にルートへ昇格" FontSize="10" Foreground="#0284C7"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="＋ ルートフォルダ新設" Height="26" Style="{StaticResource FluentButtonSecondary}"
                                            FontSize="11" Padding="8,2" Click="SimAddRootFolderButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Mock TreeView with Drop & ContextMenu -->
                            <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#FFFFFF">
                                <TreeView x:Name="SimMockTreeView" BorderThickness="0" Background="Transparent"
                                          SelectedItemChanged="SimMockTreeView_SelectedItemChanged"
                                          AllowDrop="True"
                                          Drop="SimMockTreeView_Drop"
                                          DragOver="SimMockTreeView_DragOver"
                                          PreviewMouseMove="SimMockTreeView_PreviewMouseMove">
                                    <TreeView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📁 新規サブフォルダ作成" Click="CtxSimAddChild_Click"/>
                                            <MenuItem Header="✏️ フォルダ名の変更" Click="CtxSimRename_Click"/>
                                            <Separator/>
                                            <MenuItem Header="⏮ 第1階層（ルート）へ昇格" Click="CtxSimJumpRoot_Click"/>
                                            <MenuItem Header="◀ 1階層昇格" Click="CtxSimPromote_Click"/>
                                            <MenuItem Header="▶ 1階層降格 (サブ化)" Click="CtxSimDemote_Click"/>
                                            <Separator/>
                                            <MenuItem Header="🗑️ 削除" Click="CtxSimDelete_Click"/>
                                        </ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Border CornerRadius="4" Padding="6,3" Margin="0,1" Background="Transparent">
                                                <Grid Margin="{Binding IndentMargin}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Icon & Name -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Level Pill -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Mapping Badge -->
                                                        <ColumnDefinition Width="*"/>    <!-- Quick Level Buttons -->
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="3" Padding="5,1"
                                                            Background="{Binding LevelPillBackground}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LevelPillText}" FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="{Binding LevelPillForeground}"/>
                                                    </Border>

                                                    <Border Grid.Column="2" Margin="6,0,0,0" CornerRadius="3" Padding="5,1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1"
                                                            VerticalAlignment="Center" Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding MappingBadgeText}" FontSize="9" Foreground="#B45309"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Content="⏮" Width="20" Height="20" Padding="0" FontSize="9" ToolTip="第1階層(ルート)へ一気ジャンプ"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="2,0" Click="SimQuickJumpRoot_Click" Tag="{Binding}"/>
                                                        <Button Content="◀" Width="20" Height="20" Padding="0" FontSize="9" ToolTip="1階層昇格"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="2,0" Click="SimQuickPromote_Click" Tag="{Binding}"/>
                                                        <Button Content="▶" Width="20" Height="20" Padding="0" FontSize="9" ToolTip="1階層降格"
                                                                Style="{StaticResource FluentButtonSecondary}" Margin="2,0" Click="SimQuickDemote_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Border>

                            <Separator Grid.Row="2" Margin="0,8,0,8" Background="#E2E8F0"/>

                            <!-- Accordion Panel for Selected Folder -->
                            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Selected Node Info -->
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📁 選択中のフォルダ: " FontWeight="Bold" FontSize="12" Foreground="#334155"/>
                                                <TextBlock x:Name="SimSelectedFolderNameText" Text="(未選択 - 上のフォルダをクリック)" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                            </StackPanel>
                                            <CheckBox x:Name="SimInheritCheckBox" Content="親からの権限継承を含める" HorizontalAlignment="Right"
                                                      FontSize="11" Checked="SimInheritCheckBox_Changed" Unchecked="SimInheritCheckBox_Changed"/>
                                        </Grid>

                                        <!-- Drop Zone 1: Subfolder Maker -->
                                        <Border Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6" Margin="0,0,0,8" AllowDrop="True"
                                                Drop="SimSubfolderDropZone_Drop" DragOver="SimGenericDragOver">
                                            <TextBlock Text="📥 左の現行フォルダをここにドロップすると、この直下にサブフォルダ化"
                                                       FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Drop Zone 2: N:1 Source Mapping Area -->
                                        <Border Background="#FAF5FF" BorderBrush="#C084FC" BorderThickness="1"
                                                CornerRadius="4" Padding="8" Margin="0,0,0,8" AllowDrop="True"
                                                Drop="SimMappingDropZone_Drop" DragOver="SimGenericDragOver">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="🔗 現行サーバーとの紐づけ (データ移行元 / N対1統合)" FontSize="10" FontWeight="Bold" Foreground="#7E22CE"/>
                                                    <TextBlock Text="ここに現行フォルダをドロップして追加統合" FontSize="9" Foreground="#A855F7" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <!-- List of mapped sources -->
                                                <ItemsControl x:Name="SimMappedSourcesItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FFFFFF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding StringFormat='🔗 {0}'}" FontSize="10" FontFamily="{StaticResource MonoFont}" Foreground="#4C1D95" VerticalAlignment="Center"/>
                                                                    <Button Content="✕ 解除" HorizontalAlignment="Right" FontSize="9" Foreground="#E11D48"
                                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                            Click="SimRemoveMapping_Click" Tag="{Binding}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Drop Zone 3: AD Permissions Cards Area -->
                                        <Border Background="#F0F9FF" BorderBrush="#38BDF8" BorderThickness="1"
                                                CornerRadius="4" Padding="8" AllowDrop="True"
                                                Drop="SimAclDropZone_Drop" DragOver="SimGenericDragOver">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="🛡️ 割り当てられたADアクセス権 (カードWクリックで詳細編集)" FontSize="10" FontWeight="Bold" Foreground="#0369A1"/>
                                                    <Button Content="⚙️ セキュリティ詳細設定" FontSize="9" Height="20" Padding="6,1"
                                                            Style="{StaticResource FluentButtonSecondary}" HorizontalAlignment="Right"
                                                            Click="SimOpenSecModalButton_Click"/>
                                                </Grid>
                                                <!-- Permissions Cards Grid -->
                                                <ItemsControl x:Name="SimAclCardsItemsControl">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:SimAclEntry}">
                                                            <Border Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4"
                                                                    Padding="8,4" Margin="0,0,6,6" Cursor="Hand" MouseDown="SimAclCard_MouseDown">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                                    <Border Background="#E0F2FE" CornerRadius="3" Padding="4,1" Margin="6,0,4,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FormattedRights}" FontSize="9" Foreground="#0284C7"/>
                                                                    </Border>
                                                                    <Button Content="✕" FontSize="9" Width="14" Height="14" Margin="2,0,0,0"
                                                                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                                                            Click="SimDeleteAclEntryButton_Click" Tag="{Binding}" ToolTip="権限解除"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Trash Drop Zone -->
                            <Border Grid.Row="4" x:Name="SimTrashZone" Background="#FFF1F2" BorderBrush="#F43F5E" BorderThickness="1"
                                    CornerRadius="6" Height="30" Margin="0,6,0,0" AllowDrop="True"
                                    Drop="SimTrashZone_Drop" DragOver="SimGenericDragOver">
                                <TextBlock Text="🗑️ ここにドロップして権限・紐づけをポイ捨て解除" FontSize="10" FontWeight="Bold"
                                           Foreground="#E11D48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                    <!-- ============================================== -->
                    <!-- PANE 3: AD PALETTE (USERS & GROUPS)            -->
                    <!-- ============================================== -->
                    <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="AD ユーザー &amp; グループ" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <Border x:Name="DomainStatusBadge" Background="#DCFCE7" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="DomainStatusText" Text="🟢 CORP.LOCAL" FontSize="9" FontWeight="SemiBold" Foreground="#15803D"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="カードを中央のフォルダへドラッグして権限付与" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Height="28" Padding="6,0" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍 " FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AdSearchTextBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" FontSize="11" TextChanged="AdSearchTextBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" BorderBrush="#F1F5F9" BorderThickness="1" CornerRadius="4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AdPrincipalsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:AdPrincipalItem}">
                                                <Border Background="{Binding BadgeBackground}" BorderBrush="#E2E8F0" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                                                        PreviewMouseMove="AdCard_PreviewMouseMove" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding IconGlyph}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 3: LINK FIXER (ショートカット＆リンク一括修復)        -->
            <!-- ======================================================== -->
            <Grid x:Name="LinkFixTabPanel" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="🔗 サーバー移行に伴うショートカット (LNK) / パス参照の一括修復" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="ファイルサーバー移行後、旧パス（例: \\OldServer\Share）を指したまま切断されたショートカットを一括検出し、新パスへ安全に書き換えます。"
                                       FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="検索対象フォルダ (デスクトップ等)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0">
                                    <TextBox x:Name="LinkSearchScopeTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="置換前 (旧サーバー名 / パス)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0">
                                    <TextBox x:Name="LinkOldPatternTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="置換後 (新サーバー名 / パス)" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0">
                                    <TextBox x:Name="LinkNewPatternTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11" FontFamily="{StaticResource MonoFont}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button x:Name="LinkScanButton" Content="切断リンク検出スキャン" Height="32" Margin="0,0,8,0"
                                    Style="{StaticResource FluentButtonSecondary}" Click="LinkScanButton_Click"/>
                            <Button x:Name="LinkFixExecuteButton" Content="⚡ 一括修復を実行 (バックアップ付)" Height="32"
                                    Style="{StaticResource FluentButtonPrimary}" Click="LinkFixExecuteButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="検出されたショートカット一覧" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,8"/>
                        <DataGrid x:Name="LinkItemsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" RowHeight="26" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="160" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn Header="種別" Binding="{Binding FileType}" Width="120" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn Header="現在のターゲットパス" Binding="{Binding OldTarget}" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn Header="置換後ターゲットパス" Binding="{Binding NewTarget}" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="130" ElementStyle="{StaticResource LeftAlignedCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL 1: WINDOWS SECURITY DETAILED PERMISSION MODAL      -->
        <!-- ======================================================== -->
        <Grid x:Name="SecModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Body (Basic + Adv 14 items) -->
                        <RowDefinition Height="Auto"/> <!-- Footer Buttons -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛡️ セキュリティの詳細設定 - " FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock x:Name="SecModalTargetNameText" Text="フォルダ名" FontWeight="Bold" FontSize="14" Foreground="#0284C7"/>
                        </StackPanel>
                        <Button Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Click="SecModalCancel_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Object Path -->
                            <TextBlock Text="オブジェクト名:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
                                <TextBlock x:Name="SecModalFullPathText" Text="\\NewServer01\Share\Folder" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#0369A1"/>
                            </Border>

                            <!-- Principal & Applies To -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="プリンシパル (対象アカウント):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBox x:Name="SecPrincipalInput" Height="28" FontSize="11" FontWeight="Bold" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="種類:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="SecAccessTypeCombo" Height="28" SelectedIndex="0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="許可"/>
                                        <ComboBoxItem Content="拒否"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="適用先:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox x:Name="SecAppliesToCombo" Height="28" SelectedIndex="0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="このフォルダー、サブフォルダーおよびファイル"/>
                                    <ComboBoxItem Content="このフォルダーのみ"/>
                                    <ComboBoxItem Content="このフォルダーおよびサブフォルダー"/>
                                    <ComboBoxItem Content="このフォルダーおよびファイル"/>
                                    <ComboBoxItem Content="サブフォルダーおよびファイルのみ"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Basic Permissions -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="基本アクセス許可:" FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                        <TextBlock Text="※高度な権限と完全リアルタイム連動" FontSize="10" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="SecChkFullControl" Content="フル コントロール" Margin="0,3" FontWeight="Bold" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkModify" Content="変更 (Modify)" Margin="0,3" FontWeight="Bold" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkReadExecute" Content="読み取りと実行" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkList" Content="フォルダーの内容の一覧表示" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkRead" Content="読み取り" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkWrite" Content="書き込み" Margin="0,3" Click="SecBasicPerm_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Permissions (14 items) -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="⚙️ 高度なアクセス許可 (Windows ACL 14項目完全網羅):" FontWeight="Bold" FontSize="11" Foreground="#0284C7"/>
                                        <TextBlock Text="Windows セキュリティ詳細設定準拠" FontSize="9" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="SecAdvTraverse" Content="フォルダーのスキャン / ファイルの実行" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvList" Content="フォルダーの一覧 / データの読み取り" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadAttr" Content="属性の読み取り" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadExtAttr" Content="拡張属性の読み取り" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvCreateFile" Content="ファイルの作成 / データの書き込み" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvCreateFolder" Content="フォルダーの作成 / データの追加" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvWriteAttr" Content="属性の書き込み" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvWriteExtAttr" Content="拡張属性の書き込み" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvDelete" Content="削除" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvDeleteSub" Content="サブフォルダーとファイルの削除" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadPerm" Content="アクセス許可の読み取り" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvChangePerm" Content="アクセス許可の変更" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvTakeOwnership" Content="所有権の取得" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvSync" Content="同期 (Synchronize)" Margin="0,3" FontSize="10" Click="SecAdvPerm_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="キャンセル" Height="32" Width="90" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="SecModalCancel_Click"/>
                        <Button Content="変更を保存" Height="32" Width="100" Style="{StaticResource FluentButtonPrimary}" Click="SecModalApply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL 2: HUMAN-FRIENDLY DIFF REVIEW MODAL                -->
        <!-- ======================================================== -->
        <Grid x:Name="DiffModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="980" Height="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Subtitle -->
                        <RowDefinition Height="*"/>    <!-- Diff Table -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚖️ 移行前後 変化点差分インスペクター (人間向けレビュー)" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                        </StackPanel>
                        <Button Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Click="DiffModalClose_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="現行サーバーから新環境への「統合・階層移動・新規作成・権限差分」を網羅したレビュー表です。"
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>

                    <!-- Diff DataGrid -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <DataGrid x:Name="DiffReviewDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="変化の種別" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <Border Background="{Binding DiffTypeBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DiffType}" FontWeight="Bold" FontSize="10" Foreground="{Binding DiffTypeBadgeForeground}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="現行サーバー (Before)" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding SourcePath}" FontWeight="Bold" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SourceDetail}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="新環境設計 (After)" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding TargetPath}" FontWeight="Bold" FontSize="11" Foreground="#0284C7" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TargetDetail}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="権限 (ACL) 差分詳細" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <TextBlock Text="{Binding FormattedAclChanges}" FontSize="11" Foreground="#1E293B" Margin="6,4" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="閉じる" Height="32" Width="80" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="DiffModalClose_Click"/>
                        <Button Content="📊 差分レポートをExcel出力" Height="32" Style="{StaticResource FluentButtonPrimary}" Click="DiffExportExcel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

            <!-- TOAST NOTIFICATION -->
            <Border x:Name="ToastNotificationBorder" Background="#0F172A" CornerRadius="6" Padding="14,10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡 " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastNotificationText" Text="通知メッセージ" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- GLOBAL FOOTER / STATUS BAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Text="準備完了" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <ProgressBar x:Name="GlobalProgressBar" Height="4" Width="140" Margin="12,0,0,0" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed" Foreground="{StaticResource AccentSky}" Background="#F1F5F9" BorderThickness="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FolderMorpher v2.5 - Enterprise Storage &amp; Migration Studio" FontSize="11" Foreground="{StaticResource TextSubtle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
