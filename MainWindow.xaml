                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="34" Padding="10,0">
                                        <TextBox x:Name="MediaPathTextBox" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                                    </Border>
                                    <Button x:Name="MediaBrowseButton" Grid.Column="1" Content="📁 参照" Width="96" Height="34" Margin="8,0,0,0"
                                            Style="{StaticResource FluentButtonSecondary}" Click="MediaBrowseButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock x:Name="MediaMaxDimLabel" Text="最大長辺 (px)" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="30" Width="80" Padding="6,0">
                                        <TextBox x:Name="MediaMaxDimTextBox" Text="2560" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock x:Name="MediaQualityLabel" Text="画質 (%)" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="30" Width="60" Padding="6,0">
                                        <TextBox x:Name="MediaQualityTextBox" Text="85" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="MediaMinSizeLabel" Text="最小サイズ (MB)" FontSize="10" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="30" Width="70" Padding="6,0">
                                        <TextBox x:Name="MediaMinSizeMbTextBox" Text="2" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaStatusText" Text="待機中" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="MediaExportExcelButton" Content="📊 Excelレポート出力 (.xlsx)" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="MediaExportExcelButton_Click"/>
                                <Button x:Name="MediaGenVideoBatchButton" Content="🎬 巨大動画 夜間圧縮バッチ出力 (.bat)" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="MediaGenVideoBatchButton_Click" ToolTip="GPUハードウェアエンコード (H.265) で動画を一括軽量化するスクリプトを出力"/>
                                <Button x:Name="MediaScanButton" Content="🔍 メディア走査" Height="32" Margin="0,0,8,0"
                                        Style="{StaticResource FluentButtonSecondary}" Click="MediaScanButton_Click"/>
                                <Button x:Name="MediaOptimizeButton" Content="🔍 チェック" Height="32"
                                        Style="{StaticResource FluentButtonPrimary}" Click="MediaOptimizeButton_Click"
                                        ToolTip="軽量化対象の写真一覧と設定差分をチェック"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- KPI Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="MediaKpiImagesCountTitle" Text="走査対象 画像数" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="MediaKpiImagesCount" Text="0 枚" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="MediaKpiVideosCountTitle" Text="巨大動画 ファイル数" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="MediaKpiVideosCount" Text="0 本" FontSize="18" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock x:Name="MediaKpiOptimizedCountTitle" Text="軽量化 完了数" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="MediaKpiOptimizedCount" Text="0 枚" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="MediaKpiSavedSizeTitle" Text="総削減容量 (解放された空き)" FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="MediaKpiSavedSize" Text="0 B" FontSize="18" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Results DataGrid -->
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="MediaTableTitleText" Grid.Row="0" Text="メディア一覧（画像 ＆ 巨大動画）" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <DataGrid x:Name="MediaItemsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="None" RowHeight="28" HeadersVisibility="Column" RowHeaderWidth="0"
                                  MouseDoubleClick="MediaItemsDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColMediaType" Header="種別" Binding="{Binding Extension}" Width="80" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColMediaFileName" Header="ファイル名" Binding="{Binding FileName}" Width="180" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColMediaOriginalSize" Header="元容量" Binding="{Binding OriginalSizeFormatted}" Width="100" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColMediaOptimizedSize" Header="軽量化後" Binding="{Binding OptimizedSizeFormatted}" Width="100" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColMediaSavedSize" Header="削減容量" Binding="{Binding SavedSizeFormatted}" Width="100" ElementStyle="{StaticResource RightAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColMediaStatus" Header="状態 / 聖域保護" Binding="{Binding Status}" Width="180" ElementStyle="{StaticResource LeftAlignedCell}"/>
                                <DataGridTextColumn x:Name="ColMediaFullPath" Header="完全パス" Binding="{Binding FullPath}" Width="*" ElementStyle="{StaticResource LeftAlignedCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

        <!-- ======================================================== -->
        <!-- MODAL 1: WINDOWS SECURITY DETAILED PERMISSION MODAL      -->
        <!-- ======================================================== -->
        <Grid x:Name="SecModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Body (Basic + Adv 14 items) -->
                        <RowDefinition Height="Auto"/> <!-- Footer Buttons -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SecModalTitleText" Text="🛡️ セキュリティの詳細設定 - " FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock x:Name="SecModalTargetNameText" Text="フォルダ名" FontWeight="Bold" FontSize="14" Foreground="#0284C7"/>
                        </StackPanel>
                        <Button Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Click="SecModalCancel_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Object Path -->
                            <TextBlock x:Name="SecModalObjectNameLabel" Text="オブジェクト名:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
                                <TextBlock x:Name="SecModalFullPathText" Text="\\NewServer01\Share\Folder" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#0369A1"/>
                            </Border>

                            <!-- Principal & Applies To -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock x:Name="SecModalPrincipalLabel" Text="プリンシパル (対象アカウント):" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <TextBox x:Name="SecPrincipalInput" Height="28" FontSize="11" FontWeight="Bold" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="SecModalTypeLabel" Text="種類:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="SecAccessTypeCombo" Height="28" SelectedIndex="0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="許可"/>
                                        <ComboBoxItem Content="拒否"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock x:Name="SecModalAppliesToLabel" Text="適用先:" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                <ComboBox x:Name="SecAppliesToCombo" Height="28" SelectedIndex="0" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="このフォルダー、サブフォルダーおよびファイル"/>
                                    <ComboBoxItem Content="このフォルダーのみ"/>
                                    <ComboBoxItem Content="このフォルダーおよびサブフォルダー"/>
                                    <ComboBoxItem Content="このフォルダーおよびファイル"/>
                                    <ComboBoxItem Content="サブフォルダーおよびファイルのみ"/>
                                    <ComboBoxItem Content="サブフォルダーのみ"/>
                                    <ComboBoxItem Content="ファイルのみ"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Basic Permissions -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="SecModalBasicPermTitle" Text="基本アクセス許可:" FontWeight="Bold" FontSize="12.5" Foreground="#334155"/>
                                        <TextBlock x:Name="SecModalRealtimeNotice" Text="※高度な権限と完全リアルタイム連動" FontSize="11.5" Foreground="#0284C7" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="SecChkFullControl" Content="フル コントロール" Margin="0,3" FontWeight="Bold" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkModify" Content="変更 (Modify)" Margin="0,3" FontWeight="Bold" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkReadExecute" Content="読み取りと実行" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkList" Content="フォルダーの内容の一覧表示" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkRead" Content="読み取り" Margin="0,3" Click="SecBasicPerm_Click"/>
                                        <CheckBox x:Name="SecChkWrite" Content="書き込み" Margin="0,3" Click="SecBasicPerm_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Advanced Permissions (14 items) -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="SecModalAdvPermTitle" Text="⚙️ 高度なアクセス許可 (Windows ACL 14項目完全網羅):" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                        <TextBlock x:Name="SecModalAdvPermSubtitle" Text="Windows セキュリティ詳細設定準拠" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="SecAdvTraverse" Content="フォルダーのスキャン / ファイルの実行" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvList" Content="フォルダーの一覧 / データの読み取り" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadAttr" Content="属性の読み取り" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadExtAttr" Content="拡張属性の読み取り" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvCreateFile" Content="ファイルの作成 / データの書き込み" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvCreateFolder" Content="フォルダーの作成 / データの追加" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvWriteAttr" Content="属性の書き込み" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvWriteExtAttr" Content="拡張属性の書き込み" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvDelete" Content="削除" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvDeleteSub" Content="サブフォルダーとファイルの削除" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvReadPerm" Content="アクセス許可の読み取り" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvChangePerm" Content="アクセス許可の変更" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvTakeOwnership" Content="所有権の取得" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                        <CheckBox x:Name="SecAdvSync" Content="同期 (Synchronize)" Margin="0,3" FontSize="11" Click="SecAdvPerm_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button x:Name="SecModalCancelButton" Content="キャンセル" Height="32" Width="90" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="SecModalCancel_Click"/>
                        <Button x:Name="SecModalApplyButton" Content="変更を保存" Height="32" Width="100" Style="{StaticResource FluentButtonPrimary}" Click="SecModalApply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL 2: HUMAN-FRIENDLY DIFF REVIEW MODAL                -->
        <!-- ======================================================== -->
        <Grid x:Name="DiffModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="980" Height="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Subtitle -->
                        <RowDefinition Height="*"/>    <!-- Diff Table -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="DiffModalTitleText" Text="⚖️ 変更点" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                            <TextBlock x:Name="DiffModalSubTitleText" Text=" - 移行設計差分" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Click="DiffModalClose_Click"/>
                    </Grid>

                    <!-- Summary Stats Strip -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DiffSummaryStatsText" Text="📊 差分項目: 0件" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Diff DataGrid -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
                        <DataGrid x:Name="DiffReviewDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="None" RowHeight="32"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="ColDiffType" Header="変化の種別" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <Border Background="{Binding DiffTypeBadgeBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DiffType}" FontWeight="Bold" FontSize="10" Foreground="{Binding DiffTypeBadgeForeground}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColDiffSource" Header="現行サーバー (Before)" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding SourcePath}" FontWeight="Bold" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SourceDetail}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColDiffTarget" Header="新環境設計 (After)" Width="280">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding TargetPath}" FontWeight="Bold" FontSize="11" Foreground="#0284C7" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TargetDetail}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColDiffAcl" Header="権限 (ACL) 差分詳細" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:SimDiffItem}">
                                            <TextBlock Text="{Binding FormattedAclChanges}" FontSize="11" Foreground="#1E293B" Margin="6,4" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="DiffModalCloseButton" Content="閉じる" Height="32" Width="80" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="DiffModalClose_Click"/>
                        <Button x:Name="DiffExportExcelButton" Content="📊 Excel出力" Height="32" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="DiffExportExcel_Click"/>
                        <Button x:Name="DiffModalApplyButton" Content="⚡ 適用" Height="32" Style="{StaticResource FluentButtonPrimary}" Click="DiffModalApply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL: LINK FIX DRY-RUN DIFF MODAL                       -->
        <!-- ======================================================== -->
        <Grid x:Name="LinkFixDiffModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="920" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Summary Strip -->
                        <RowDefinition Height="*"/>    <!-- Diff Table -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LinkFixDiffTitleText" Text="⚖️ 変更点" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                            <TextBlock x:Name="LinkFixDiffSubTitleText" Text=" - ショートカット一括修復" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Click="LinkFixDiffModalClose_Click"/>
                    </Grid>

                    <!-- Summary Stats Strip -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LinkFixDiffSummaryText" Text="📊 修復対象: 0件 (各ファイル .bak 自動バックアップ生成)" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Diff DataGrid -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
                        <DataGrid x:Name="LinkFixDiffDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="None" RowHeight="30"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="200"/>
                                <DataGridTemplateColumn Header="置換前ターゲット (Before)" Width="320">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OldTarget}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding OldTarget}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="置換後ターゲット (After)" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NewTarget}" FontWeight="SemiBold" FontSize="11" Foreground="#0284C7" TextTrimming="CharacterEllipsis" ToolTip="{Binding NewTarget}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="LinkFixDiffModalCloseButton" Content="閉じる" Height="32" Width="80" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="LinkFixDiffModalClose_Click"/>
                        <Button x:Name="LinkFixDiffModalApplyButton" Content="⚡ 適用" Height="32" Style="{StaticResource FluentButtonPrimary}" Click="LinkFixDiffModalApply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- MODAL: MEDIA OPTIMIZER DRY-RUN DIFF MODAL                -->
        <!-- ======================================================== -->
        <Grid x:Name="MediaDiffModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="920" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Summary Strip -->
                        <RowDefinition Height="*"/>    <!-- Diff Table -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="MediaDiffTitleText" Text="⚖️ 変更点" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                            <TextBlock x:Name="MediaDiffSubTitleText" Text=" - 写真・画像軽量化 (上書き縮小)" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                FontSize="12" Foreground="#64748B" HorizontalAlignment="Right" Click="MediaDiffModalClose_Click"/>
                    </Grid>

                    <!-- Summary Stats Strip -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="MediaDiffSummaryText" Text="📊 対象: 0枚 / 設定: 長辺 2560px・品質 85% (🛡️ 聖域保護除外済)" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Diff DataGrid -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="2">
                        <DataGrid x:Name="MediaDiffDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  BorderThickness="0" Background="Transparent" GridLinesVisibility="None" RowHeight="30"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="200"/>
                                <DataGridTextColumn Header="元容量" Binding="{Binding OriginalSizeFormatted}" Width="110"/>
                                <DataGridTextColumn Header="現在の解像度" Binding="{Binding DimensionsFormatted}" Width="130"/>
                                <DataGridTemplateColumn Header="完全パス" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="MediaDiffModalCloseButton" Content="閉じる" Height="32" Width="80" Margin="0,0,8,0" Style="{StaticResource FluentButtonSecondary}" Click="MediaDiffModalClose_Click"/>
                        <Button x:Name="MediaDiffModalApplyButton" Content="⚡ 適用" Height="32" Style="{StaticResource FluentButtonPrimary}" Click="MediaDiffModalApply_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


        <!-- ======================================================== -->
        <!-- MODAL 3: SETTINGS MODAL (環境設定: キャッシュ共有・保存先)   -->
        <!-- ======================================================== -->
        <Grid x:Name="SettingsModalOverlay" Grid.RowSpan="3" Background="#80000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" Width="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- Description -->
                        <RowDefinition Height="*"/>    <!-- Settings Body -->
                        <RowDefinition Height="Auto"/> <!-- Actions -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="SettingsTitleText" Text="⚙️ 環境設定 (Settings)" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="SettingsDescText" Text="キャッシュ、スナップショット履歴、監査レポートの参照先および保存先を構成します。" FontSize="11.5" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Settings Body -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,16">
                        <!-- Read Cache Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="SettingsReadTitleText" Text="📂 キャッシュ・スナップショット 参照先 (読み込み)" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                                <TextBlock x:Name="SettingsReadDescText" Text="共有ファイルサーバー上のマスターキャッシュ（UNCパス等）を指定すると、チーム共通の0秒ツリーや推移履歴を参照できます。" FontSize="11" Foreground="#64748B" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsReadPathTextBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12"
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"
                                             ToolTip="空の場合はローカル既定値 (%LocalAppData%\FolderMorpher) を参照します"/>
                                    <Button x:Name="SettingsBrowseReadButton" Grid.Column="1" Content="参照..." Margin="8,0,0,0" Width="70" Height="32"
                                            Style="{StaticResource FluentButtonSecondary}" Click="SettingsBrowseReadButton_Click"/>
                                </Grid>
                                <CheckBox x:Name="SettingsFallbackCheckBox" Content="共有参照先にアクセスできない場合は自動でローカルキャッシュを参照する"
                                          IsChecked="True" FontSize="11.5" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Write Cache Card -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="SettingsWriteTitleText" Text="💾 キャッシュ・スナップショット 保存先 (書き込み)" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B"/>
                                <TextBlock x:Name="SettingsWriteDescText" Text="自身がスキャンした結果のツリーキャッシュおよび履歴データの保存場所を選択します。" FontSize="11" Foreground="#64748B" Margin="0,2,0,8" TextWrapping="Wrap"/>

                                <RadioButton x:Name="SettingsWriteModeLocalRadio" GroupName="WriteMode" IsChecked="True" Margin="0,2,0,4"
                                             Checked="SettingsWriteModeRadio_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SettingsWriteLocalText" Text="ローカルに保存" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock x:Name="SettingsWriteLocalSubText" Text=" (推奨: マスターキャッシュを上書きしない安全設定)" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="SettingsWriteModeSameRadio" GroupName="WriteMode" Margin="0,2,0,4"
                                             Checked="SettingsWriteModeRadio_Checked">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SettingsWriteSameText" Text="参照先と同じフォルダーに保存" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                        <TextBlock x:Name="SettingsWriteSameSubText" Text=" (管理者・マスター更新者用)" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton x:Name="SettingsWriteModeCustomRadio" GroupName="WriteMode" Margin="0,2,0,4"
                                             Checked="SettingsWriteModeRadio_Checked">
                                    <TextBlock x:Name="SettingsWriteCustomText" Text="任意のカスタムフォルダーを指定" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                                </RadioButton>

                                <Grid x:Name="SettingsCustomPathGrid" Margin="22,6,0,0" IsEnabled="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SettingsCustomPathTextBox" Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="11.5"
                                             Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                    <Button x:Name="SettingsBrowseCustomButton" Grid.Column="1" Content="参照..." Margin="8,0,0,0" Width="70" Height="30"
                                            Style="{StaticResource FluentButtonSecondary}" Click="SettingsBrowseCustomButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SettingsCancelButton" Content="キャンセル" Width="90" Height="32" Margin="0,0,8,0"
                                Style="{StaticResource FluentButtonSecondary}" Click="SettingsCancelButton_Click"/>
                        <Button x:Name="SettingsSaveButton" Content="設定を保存" Width="100" Height="32"
                                Style="{StaticResource FluentButtonPrimary}" Click="SettingsSaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

            <!-- TOAST NOTIFICATION -->
            <Border x:Name="ToastNotificationBorder" Background="#0F172A" CornerRadius="6" Padding="14,10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡 " FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastNotificationText" Text="通知メッセージ" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- GLOBAL FOOTER / STATUS BAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTextBlock" Text="準備完了" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    <ProgressBar x:Name="GlobalProgressBar" Height="4" Width="140" Margin="12,0,0,0" Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed" Foreground="{StaticResource AccentSky}" Background="#F1F5F9" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
