<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FolderMorpher</AssemblyName>
    <RootNamespace>FolderMorpher</RootNamespace>
    <ApplicationTitle>FolderMorpher - Storage &amp; Migration Studio</ApplicationTitle>
    <Version>2.2.20</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.12" />
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="FolderMorpher.Core\**" />
    <Compile Remove="FolderMorpher.Host\**" />
    <EmbeddedResource Remove="FolderMorpher.Core\**" />
    <EmbeddedResource Remove="FolderMorpher.Host\**" />
    <None Remove="FolderMorpher.Core\**" />
    <None Remove="FolderMorpher.Host\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FolderMorpher.Core\FolderMorpher.Core.csproj" />
  </ItemGroup>

</Project>
