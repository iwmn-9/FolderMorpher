<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>AstraSize.Bootstrap</StartupObject>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <AssemblyName>FolderMorpher</AssemblyName>
    <RootNamespace>FolderMorpher</RootNamespace>
    <ApplicationTitle>FolderMorpher - Storage &amp; Migration Studio</ApplicationTitle>
    <Version>2.2.33</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="Bootstrap.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FolderMorpher.Contracts\FolderMorpher.Contracts.csproj" />
    <ProjectReference Include="FolderMorpher.Host\FolderMorpher.Host.csproj" />
    <ProjectReference Include="FolderMorpher.UI\FolderMorpher.UI.csproj" />
  </ItemGroup>

</Project>
